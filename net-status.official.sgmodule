#!name=网络状态 𝕏
#!desc=显示当前网络运营商、WiFi名称/蜂窝4G5G、本地IP、IPv4/IPv6协议支持。网络变化时即时通知。数据接口: ip.cip.cc (备用: ip-api.com)。提示: 如需获取本地运营商而非代理运营商, 请为 ip.cip.cc 和 ip-api.com 设置 DIRECT 分流。
#!category=network
#!author=@Minis
#!arguments=ICON:antenna.radiowaves.left.and.right,ICON-COLOR:#34C759,TIMEOUT:5,EVENT_SCRIPT_NAME:网络状态通知,EVENT_DELAY:1,PANEL_NAME:网络状态面板,UPDATE-INTERVAL:-1
#!arguments-desc=参数说明（按参数顺序）\n\n① [ICON] 面板图标，填 SF Symbol 名称，如 wifi、network、antenna.radiowaves.left.and.right\n② [ICON-COLOR] 面板图标颜色，十六进制色值，如 #34C759\n③ [TIMEOUT] 运营商查询的超时时间（秒）\n④ [EVENT_SCRIPT_NAME] 网络变化通知的脚本名；填 # 可禁用通知\n⑤ [EVENT_DELAY] 网络变化后延迟多久再查询（秒），建议 1-3\n⑥ [PANEL_NAME] 状态面板名称；填 # 可禁用面板\n⑦ [UPDATE-INTERVAL] 面板自动刷新间隔（秒），-1 为仅手动刷新

[Script]
# Event - 网络变化即时通知
{{{EVENT_SCRIPT_NAME}}} = type=event,event-name=network-changed,timeout=120,script-path=https://raw.githubusercontent.com/Yjwj205/surge-modules/main/net-status.js,argument="TYPE=EVENT&icon={{{ICON}}}&icon-color={{{ICON-COLOR}}}&TIMEOUT={{{TIMEOUT}}}&EVENT_DELAY={{{EVENT_DELAY}}}"

# Panel - 网络状态面板
网络状态面板 = type=generic,timeout=120,script-path=https://raw.githubusercontent.com/Yjwj205/surge-modules/main/net-status.js,argument="icon={{{ICON}}}&icon-color={{{ICON-COLOR}}}&TIMEOUT={{{TIMEOUT}}}"

[Panel]
{{{PANEL_NAME}}} = script-name=网络状态面板,update-interval={{{UPDATE-INTERVAL}}}
