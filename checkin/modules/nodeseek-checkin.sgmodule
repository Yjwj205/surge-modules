#!name=NodeSeek 签到增强版
#!desc=NodeSeek 论坛每日自动签到，支持 TG 推送与 Cookie 过期提醒。开启抓取开关后访问个人主页即可抓取 Cookie。
#!author=Roddy-D (Loon 版) / 转 Surge: Yjwj205
#!homepage=https://github.com/Roddy-D/Loon_plugins
#!icon=https://raw.githubusercontent.com/Roddy-D/Loon_plugins/refs/heads/main/icon/nscheckin.png
#!category=签到
#!arguments=CRON_TIME:1 0 * * *,ENABLE_CAPTURE:true,NS_COOKIE:none,TG_BOT_TOKEN:none,TG_USER_ID:none,TG_NOTIFY_ONLY_FAIL:false,RANDOM_REWARD:false
#!arguments-desc=[CRON_TIME] 签到执行时间（5 段 cron） / [ENABLE_CAPTURE] 打开后在 NodeSeek 页面可自动抓取 Cookie / [NS_COOKIE] Cookie，抓取后自动保存在本地，也可手动粘贴 / [TG_BOT_TOKEN] 选填，Telegram Bot Token / [TG_USER_ID] 选填，接收消息的 User ID / [TG_NOTIFY_ONLY_FAIL] 仅失败时推送 TG / [RANDOM_REWARD] 随机奖励模式

[Script]
NodeSeek-CookieCapture = type=http-request, pattern=^https:\/\/www\.nodeseek\.com\/api\/account\/getInfo\/, script-path=https://raw.githubusercontent.com/Yjwj205/surge-modules/main/checkin/scripts/nscheckin.js, argument="ENABLE_CAPTURE={{{ENABLE_CAPTURE}}}", requires-body=0, max-size=0
NodeSeek-Checkin = type=cron, cronexp="{{{CRON_TIME}}}", script-path=https://raw.githubusercontent.com/Yjwj205/surge-modules/main/checkin/scripts/nscheckin.js, argument="NS_COOKIE={{{NS_COOKIE}}}&TG_BOT_TOKEN={{{TG_BOT_TOKEN}}}&TG_USER_ID={{{TG_USER_ID}}}&TG_NOTIFY_ONLY_FAIL={{{TG_NOTIFY_ONLY_FAIL}}}&RANDOM_REWARD={{{RANDOM_REWARD}}}", timeout=60, wake-system=1

NodeSeek-CheckinManual = type=generic, script-path=https://raw.githubusercontent.com/Yjwj205/surge-modules/main/checkin/scripts/nscheckin.js, argument="NS_COOKIE={{{NS_COOKIE}}}&TG_BOT_TOKEN={{{TG_BOT_TOKEN}}}&TG_USER_ID={{{TG_USER_ID}}}&TG_NOTIFY_ONLY_FAIL={{{TG_NOTIFY_ONLY_FAIL}}}&RANDOM_REWARD={{{RANDOM_REWARD}}}", timeout=60

[Panel]
NodeSeek 手动签到 = script-name=NodeSeek-CheckinManual, update-interval=-1

[MITM]
hostname = %APPEND% www.nodeseek.com
