#!name=iKuuu 每日签到
#!desc=自动签到 ikuuu.org：可开关的 Cookie 自动抓取、每日定时签到，通知签到结果和剩余流量。首次使用先打开「抓取 Cookie」并在 Safari 登录一次，也可直接填 Cookie。
#!author=Yjwj205 / Minis
#!homepage=https://github.com/Yjwj205/loon-modules
#!category=签到
#!arguments=cookie:none,capture:true,notify:true,cronExpr:0 8 * * *
#!arguments-desc=[cookie] 手动填写 Cookie，留空则用自动抓取的值 / [capture] 抓取 Cookie 开关，true 开启 / [notify] 签到通知，true 开启 / [cronExpr] 5 段 cron，默认每天 08:00

[Script]
iKuuu-CookieCapture = type=http-request, pattern=^https?:\/\/(?:www\.)?ikuuu\.org(?:[\/?]|$), script-path=https://raw.githubusercontent.com/Yjwj205/surge-modules/main/checkin/scripts/ikuuu-cookie.js, argument="notify={{{notify}}}&capture={{{capture}}}", max-size=-1
iKuuu-LoginCookie = type=http-response, pattern=^https:\/\/ikuuu\.org\/auth\/login, script-path=https://raw.githubusercontent.com/Yjwj205/surge-modules/main/checkin/scripts/ikuuu-cookie.js, argument="notify={{{notify}}}&capture={{{capture}}}", max-size=0
iKuuu-CheckinManual = type=generic, script-path=https://raw.githubusercontent.com/Yjwj205/surge-modules/main/checkin/scripts/ikuuu-checkin.js, argument="cookie={{{cookie}}}&notify={{{notify}}}", timeout=60
iKuuu-CheckinCron = type=cron, cronexp="{{{cronExpr}}}", script-path=https://raw.githubusercontent.com/Yjwj205/surge-modules/main/checkin/scripts/ikuuu-checkin.js, argument="cookie={{{cookie}}}&notify={{{notify}}}", timeout=60, wake-system=1


[Panel]
iKuuu 手动签到 = script-name=iKuuu-CheckinManual, update-interval=-1

[MITM]
hostname = %APPEND% ikuuu.org, *.ikuuu.org
