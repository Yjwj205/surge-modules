#!name=定时切换策略
#!desc=按时间到点把指定策略组切换到指定节点：默认 09:00 → Matrix、19:00 → 吹雪云观影组。幂等（已是目标就不动）、切换后可通知；另带信息面板显示当前节点与下次切换时间。
#!author=Yjwj205 / Minis
#!homepage=https://github.com/Yjwj205/surge-modules
#!category=策略
#!arguments=group:综合利用EMBY4837,amCron:0 9 * * *,amTarget:Matrix,pmCron:0 19 * * *,pmTarget:吹雪云观影组,notify:true,wake:true
#!arguments-desc=[group] 策略组名称，必须与 Surge 里完全一致且为 select 类型 / [amCron] 早间切换的 5 段 cron，默认 0 9 * * * / [amTarget] 早间目标子策略 / [pmCron] 晚间 cron，默认 0 19 * * * / [pmTarget] 晚间目标子策略 / [notify] 切换成功后通知 / [wake] iOS 到点唤醒 Surge 执行（关闭后可能错过时间）

[Script]
PolicySwitch-AM = type=cron, cronexp="{{{amCron}}}", script-path=https://raw.githubusercontent.com/Yjwj205/surge-modules/main/policy-switcher/policy-switcher.js, argument="mode=am&group={{{group}}}&amCron={{{amCron}}}&amTarget={{{amTarget}}}&pmCron={{{pmCron}}}&pmTarget={{{pmTarget}}}&notify={{{notify}}}", timeout=20, wake-system={{{wake}}}
PolicySwitch-PM = type=cron, cronexp="{{{pmCron}}}", script-path=https://raw.githubusercontent.com/Yjwj205/surge-modules/main/policy-switcher/policy-switcher.js, argument="mode=pm&group={{{group}}}&amCron={{{amCron}}}&amTarget={{{amTarget}}}&pmCron={{{pmCron}}}&pmTarget={{{pmTarget}}}&notify={{{notify}}}", timeout=20, wake-system={{{wake}}}
PolicySwitch-CatchUp = type=event, event-name=engine-started, script-path=https://raw.githubusercontent.com/Yjwj205/surge-modules/main/policy-switcher/policy-switcher.js, argument="mode=auto&group={{{group}}}&amCron={{{amCron}}}&amTarget={{{amTarget}}}&pmCron={{{pmCron}}}&pmTarget={{{pmTarget}}}&notify={{{notify}}}", timeout=20
PolicySwitch-Panel = type=generic, script-path=https://raw.githubusercontent.com/Yjwj205/surge-modules/main/policy-switcher/policy-switcher.js, argument="mode=auto&group={{{group}}}&amCron={{{amCron}}}&amTarget={{{amTarget}}}&pmCron={{{pmCron}}}&pmTarget={{{pmTarget}}}&notify=false", timeout=20

[Panel]
PolicySwitcher = title="定时切换策略", content="正在读取策略状态…", style=info, script-name=PolicySwitch-Panel, update-interval=60
