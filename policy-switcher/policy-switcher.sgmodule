#!name=定时切换策略·准点
#!desc=移植自 Loon 版 policy-exact.plugin：两条准点 cron，默认 09:00 切到 Matrix、19:00 切到吹雪云观影组。不轮询；已在目标上则不切换，但会通知提醒。
#!author=Yjwj205 / Minis
#!homepage=https://github.com/Yjwj205/surge-modules
#!category=策略
#!arguments=group:综合利用EMBY4837,amTime:0 0 9 * * *,amTarget:Matrix,pmTime:0 0 19 * * *,pmTarget:吹雪云观影组,notify:true
#!arguments-desc=[group] 策略组名称，必须与 Surge 中的策略组名完全一致 / [amTime] 早上触发时间，6 段 cron：秒 分 时 日 月 周，0 0 9 * * * = 每天 09:00:00 / [amTarget] 早上切换为，填子策略名称 / [pmTime] 晚上触发时间，0 0 19 * * * = 每天 19:00:00 / [pmTarget] 晚上切换为 / [notify] 切换时通知

[Script]
PolicySwitch-AM = type=cron, cronexp="{{{amTime}}}", script-path=https://raw.githubusercontent.com/Yjwj205/surge-modules/main/policy-switcher/policy-switcher.js?v=3, script-update-interval=3600, argument="group={{{group}}}&target={{{amTarget}}}&notify={{{notify}}}", timeout=20, wake-system=1
PolicySwitch-PM = type=cron, cronexp="{{{pmTime}}}", script-path=https://raw.githubusercontent.com/Yjwj205/surge-modules/main/policy-switcher/policy-switcher.js?v=3, script-update-interval=3600, argument="group={{{group}}}&target={{{pmTarget}}}&notify={{{notify}}}", timeout=20, wake-system=1
