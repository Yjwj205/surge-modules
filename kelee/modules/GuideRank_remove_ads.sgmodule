#!name=盖得排行去广告
#!desc=精简首页、移除分类横幅推广、单单返猜你喜欢和编辑精选，移除我的页面推广。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/GuideRank.png
#!category=去广告

[Body Rewrite]
http-response-jq (?i)^https:\/\/zone\.guiderank-app\.com\/guiderank-web\/app\/home\/getHomePageV 'del(.data.countdownBanner) | del(.data.newEvaluations) | del(.data.freeToPayBannerPhotoUrl) | del(.data.groupBuyingList) | del(.data.multiCountdownBanner) | del(.data.banners) | del(.data.multiPlatformBanner) | del(.data.specialSaleBannerPhotoUrl) | del(.data.guide90Evaluation) | del(.data.insurancePromotions)'
http-response-jq (?i)^https:\/\/zone\.guiderank-app\.com\/guiderank-web\/app\/common\/getInitData\.do 'del(.data.SpecialSalePageMidTabConfig)'

[Map Local]
(?i)^https:\/\/zone\.guiderank-app\.com\/guiderank-web\/app\/common\/getWeworkPromotionInfoBySceneType data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/zone\.guiderank-app\.com\/guiderank-web\/app\/popUpAdCollection\/getActiveCollection\.do data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/zone\.guiderank-app\.com\/guiderank-web\/app\/common\/getWeworkPromotionInfoBySceneType data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/zone\.guiderank-app\.com\/guiderank-web\/app\/common\/getWeworkCategoryPromotionInfo data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/zone\.guiderank-app\.com\/guiderank-web\/app\/stockTaking\/pageStockTakingForHomePage data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/zone\.guiderank-app\.com\/guiderank-web\/app\/specialSale\/pageRecommendedItems data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/zone\.guiderank-app\.com\/guiderank-web\/app\/manualOperationGoods\/pageManualOperationGoods data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/zone\.guiderank-app\.com\/guiderank-web\/app\/specialSale\/listSpecialSalePageBanner data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/zone\.guiderank-app\.com\/guiderank-web\/app\/personal\/getPersonPageInfo\.do data-type=text data="{}" header="Content-Type:application/json" status-code=200

[MITM]
hostname = %APPEND% zone.guiderank-app.com
