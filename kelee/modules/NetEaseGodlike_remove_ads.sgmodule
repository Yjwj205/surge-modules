#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/NetEaseGodlike.png
#!category=去广告

[Map Local]
(?i)^https:\/\/god\.gameyw\.netease\.com\/v\d\/ad data-type=text data="" status-code=404

[Script]
NetEaseGodlike_remove_ads · 网易大神去广告 = type=http-response, pattern=(?i)^https:\/\/app-conf\.ds\.163\.com\/v1\/app\/base\/conf\/static\/start-config\?os=ios, script-path=https://raw.githubusercontent.com/Yjwj205/surge-modules/main/kelee/scripts/JavaScript/NetEaseGodlike/NetEaseGodlike_remove_ads.js, requires-body=1, max-size=-1, timeout=10

[MITM]
hostname = %APPEND% god.gameyw.netease.com, app-conf.ds.163.com
