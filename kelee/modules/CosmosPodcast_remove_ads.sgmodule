#!name=小宇宙去广告
#!desc=移除开屏广告、搜索框推荐词和AI总结。
#!author=wish
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/CosmosPodcast.png
#!category=去广告

[Body Rewrite]
http-response-jq (?i)^https:\/\/api\.xiaoyuzhoufm\.com\/v1\/discovery-feed\/list '.data |= map(select(.type != "DISCOVERY_HEADER" and .type != "DISCOVERY_BANNER"))'

[Map Local]
(?i)^https:\/\/api\.xiaoyuzhoufm\.com\/v\d\/flash data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/api\.xiaoyuzhoufm\.com\/v\d\/ai data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/api\.xiaoyuzhoufm\.com\/v\d\/search\/get data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https?:\/\/api\.xiaoyuzhoufm\.com\/v\d\/category data-type=text data="{}" header="Content-Type:application/json" status-code=200

[MITM]
hostname = %APPEND% api.xiaoyuzhoufm.com
