#!name=WPS每日签到
#!desc=WPS每日签到并兑换会员，需要进入此插件的主页链接，阅读使用说明操作。
#!author=小白脸
#!homepage=https://github.com/luestr/ProxyResource/blob/main/Resource/Markdown/WPS/README.md
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/WPS.png
#!category=签到
#!arguments=CaptureCookie:false,AK,SK,DAY:1,MAX_RETRIES:5,CRONEXP:0 8 * * *
#!arguments-desc=[CaptureCookie] 捕获Cookie / [AK] 百度API Key / [SK] 百度Secret Key / [DAY] 兑换天数 / [MAX_RETRIES] 失败重试次数 / [CRONEXP] 定时参数

[Script]
WPS_checkin · 捕获Cookie = type=http-request, pattern=(?i)^https:\/\/moapi\.wps\.cn\/app\/ios\/v1\/app$, script-path=https://raw.githubusercontent.com/Yjwj205/surge-modules/main/kelee/scripts/JavaScript/WPS/WPS_checkin.js, requires-body=1, max-size=-1
WPS_checkin · WPS每日签到 = type=cron, cronexp="{{CRONEXP}}", script-path=https://raw.githubusercontent.com/Yjwj205/surge-modules/main/kelee/scripts/JavaScript/WPS/WPS_checkin.js, argument="AK={{{AK}}}&SK={{{SK}}}&MAX_RETRIES={{{MAX_RETRIES}}}", timeout=120

[MITM]
hostname = %APPEND% moapi.wps.cn
