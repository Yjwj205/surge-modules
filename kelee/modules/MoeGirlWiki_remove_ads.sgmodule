(?i)^https:\/\/grpc\.moegirl\.org\.cn\/moegirl\.moepad\.MoepadService\/GetLaunchAdPage$ data-type=text data="" status-code=404
(?i)^https:\/\/grpc\.moegirl\.org\.cn\/moegirl\.moepad\.MoepadService\/GetFeedAdProbability$ data-type=text data="" status-code=404

[MITM]
hostname = %APPEND% grpc.moegirl.org.cn
