#!name=口袋壁纸去广告
#!desc=移除悬浮广告，精简我的页面。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/ShoujiDesk.png
#!category=去广告

[Map Local]
(?i)^https:\/\/api\.tdz5\.com\/search\/hotword\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/api\.tdz5\.com\/ring\/hot\? data-type=text data="{}" header="Content-Type:application/json" status-code=200

[Script]
ShoujiDesk_remove_ads · 移除首页广告配置 = type=http-response, pattern=(?i)^https:\/\/api\.tdz5\.com\/base\/init\?, script-path=https://raw.githubusercontent.com/Yjwj205/surge-modules/main/kelee/scripts/JavaScript/ShoujiDesk/base_init.js, requires-body=1, max-size=-1

[MITM]
hostname = %APPEND% api.tdz5.com
