#!name=TeraBox去广告
#!desc=移除开屏广告、应用内悬浮窗、弹窗广告及横幅广告。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/TeraBox.png
#!category=去广告

[Rule]
DOMAIN, ymg-api.terabox.com, REJECT

[Map Local]
(?i)^https:\/\/www\.terabox\.com\/adx\/ data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/www\.terabox\.com\/api\/ad\/ data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/www\.terabox\.com\/api\/page\/tips\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/www\.terabox\.com\/rest\/1\.0\/task\/common\/inttips\? data-type=text data="{}" header="Content-Type:application/json" status-code=200

[MITM]
hostname = %APPEND% www.terabox.com
