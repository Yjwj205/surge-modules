#!name=成分喵去广告
#!desc=移除首页推广活动、广告组件请求、移除被查商品购买链接、搜索发现。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/ChengFenMiao.png
#!category=去广告

[Body Rewrite]
http-response-jq (?i)^https:\/\/app\.chengfenmiao\.com\/helper\/setting\? 'del(.detail_buy_sites) | del(.bottom_sites)'

[Map Local]
(?i)^https:\/\/app\.chengfenmiao\.com\/Listing\/LiveHots\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/app\.chengfenmiao\.com\/helper\/VersionCheck\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/app\.chengfenmiao\.com\/item\/closet\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/app\.chengfenmiao\.com\/Helper\/HotWords\? data-type=text data="{}" header="Content-Type:application/json" status-code=200

[MITM]
hostname = %APPEND% app.chengfenmiao.com
