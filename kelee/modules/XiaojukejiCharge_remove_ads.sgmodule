#!name=小桔充电去广告
#!desc=移除横幅广告、弹窗广告，精简我的页面。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/XiaojukejiCharge.png
#!category=去广告

[Body Rewrite]
http-response-jq (?i)^https:\/\/energy\.xiaojukeji\.com\/am\/marketing\/api\/member\/facade\/charge\/personal\/center\? 'del(.data)'

[Map Local]
(?i)^https:\/\/energy\.xiaojukeji\.com\/energy\/hummer\/api\/resource\/display($|\?) data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/energy\.xiaojukeji\.com\/lego\/api\/orderSprint\/stair\/info($|\?) data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/energy\.xiaojukeji\.com\/station-api\/search\/preWords$ data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/am\.didistatic\.com\/static\/am\/cf-terminal\/epower\/epower-thanos-app\/\d+\.\d+\.\d+\/pages\/people\/index\.js$ data-type=file data="https://raw.githubusercontent.com/Yjwj205/surge-modules/main/kelee/scripts/JavaScript/XiaojukejiCharge/XiaojukejiCharge_remove_ads.js"

[MITM]
hostname = %APPEND% energy.xiaojukeji.com, am.didistatic.com
