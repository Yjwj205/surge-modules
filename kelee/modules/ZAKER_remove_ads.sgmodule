#!name=ZAKER去广告
#!desc=移除开屏广告、置顶轮播图广告和文末广告。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/ZAKER.png
#!category=去广告

[Body Rewrite]
http-response-jq (?i)^https:\/\/iphone\.myzaker\.com\/zaker\/article_mongo_sec\.php\? 'del(.data.ad_url)'
http-response-jq (?i)^https:\/\/ggs\.myzaker\.com\/zk_article_ad\.php\? 'del(.data.article_bottom) | del(.data.recommend_ad)'
http-response-jq (?i)^https:\/\/iphone\.myzaker\.com\/zaker\/follow_promote\.php\? '.data.list |= map(select(.type != "web"))'
http-response-jq (?i)^https:\/\/iphone\.myzaker\.com\/zaker\/car_tab\/index\.php\? '.data.gallery |= map(select(.type != "web"))'

[Map Local]
(?i)^https:\/\/iphone\.myzaker\.com\/zaker\/cover\.php\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/iphone\.myzaker\.com\/zaker\/block_top_ad\.php\? data-type=text data="{}" header="Content-Type:application/json" status-code=200

[MITM]
hostname = %APPEND% iphone.myzaker.com, ggs.myzaker.com
