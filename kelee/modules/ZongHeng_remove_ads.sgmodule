#!name=纵横小说去广告
#!desc=移除纵横小说开屏广告和弹窗
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/ZongHeng.png
#!category=去广告

[Map Local]
(?i)^https:\/\/api1\.zongheng\.com\/iosapi\/system\/startup$ data-type=text data="" status-code=404
(?i)^https:\/\/api2\.zongheng\.com\/api\/giftBag\/bindingBag$ data-type=text data="{}" header="Content-Type:application/json" status-code=200

[MITM]
hostname = %APPEND% api?.zongheng.com
