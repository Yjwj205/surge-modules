#!name=完美世界电竞去广告
#!desc=移除开屏广告，精简搜索页。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/PerfectWorldEsport.png
#!category=去广告

[Body Rewrite]
http-response-jq (?i)^https:\/\/api\.wmpvp\.com\/api\/v1\/config\/promote$ 'del(.data.ad)'

[Map Local]
(?i)^https:\/\/appactivity\.wmpvp\.com\/hotsearch\/all\? data-type=text data="{}" header="Content-Type:application/json" status-code=200

[MITM]
hostname = %APPEND% api.wmpvp.com, appactivity.wmpvp.com
