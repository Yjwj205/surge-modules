#!name=行者户外去广告
#!desc=移除弹窗广告、发现页面横幅推广的推广金刚位，移除我的页面横幅推广。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/OnTheWay.png
#!category=去广告

[Body Rewrite]
http-response-jq (?i)^https:\/\/www\.imxingzhe\.com\/api\/v4\/account\/get_user_info\? 'del(.banner)'
http-response-jq (?i)^https:\/\/www\.imxingzhe\.com\/api\/v4\/discovery\/ios\/\? 'del(.banners) | del(.ad)'
http-response-jq (?i)^https:\/\/www\.imxingzhe\.com\/api\/v4\/discovery\/ios\/\? '.display_areas |= map(select(.name == "赛事" or .name == "行者帮" or .name == "头条" or .name == "排行榜" or .name == "约伴"))'

[Map Local]
(?i)^https:\/\/www\.imxingzhe\.com\/api\/v1\/pop\/window\/\? data-type=text data="{}" header="Content-Type:application/json" status-code=200

[MITM]
hostname = %APPEND% www.imxingzhe.com
