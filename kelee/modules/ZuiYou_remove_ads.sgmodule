#!name=最右去广告
#!desc=移除开屏广告、信息流广告和广告轮播图。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/ZuiYou.png
#!category=去广告

[Rule]
DOMAIN, adapi.izuiyou.com, REJECT
URL-REGEX, "^http:\/\/mercury-gateway\.ixiaochuan\.cn\/mercury\/v1\/ad\/",REJECT
URL-REGEX, "^http:\/\/file-share\.izuiyou\.com\/octopus\/media\/templates\/search_home_page_(nv|nv_v2)\/search_home_page_nv", REJECT

[Map Local]
(?i)^https?:\/\/api\.izuiyou\.com\/config\/get_banner data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https?:\/\/api\.izuiyou\.com\/ad\/ data-type=text data="" status-code=404
(?i)^https:\/\/zyfile\.izuiyou\.com\/zyfile\/c2\/a0\/[a-z0-9-]+\.json data-type=text data="{}" header="Content-Type:application/json" status-code=200

[MITM]
hostname = %APPEND% api.izuiyou.com, zyfile.izuiyou.com
