#!name=最美壁纸去广告
#!desc=移除悬浮广告、横幅广告、轮播图广告，精简我的页面。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/iWallBiZhi.png
#!category=去广告

[Map Local]
(?i)^https:\/\/api\.fzxhmy\.com\/seek\/trendingword\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/api\.fzxhmy\.com\/tone\/trending\? data-type=text data="{}" header="Content-Type:application/json" status-code=200

[Script]
iWallBiZhi_remove_ads · 移除首页广告配置 = type=http-response, pattern=(?i)^https:\/\/api\.fzxhmy\.com\/core\/initialize\?, script-path=https://raw.githubusercontent.com/Yjwj205/surge-modules/main/kelee/scripts/JavaScript/iWallBiZhi/core_initialize.js, requires-body=1, max-size=-1
iWallBiZhi_remove_ads · 移除首页轮播图广告 = type=http-response, pattern=(?i)^https:\/\/api\.fzxhmy\.com\/landing\/initialize\?, script-path=https://raw.githubusercontent.com/Yjwj205/surge-modules/main/kelee/scripts/JavaScript/iWallBiZhi/landing_initialize.js, requires-body=1, max-size=-1
iWallBiZhi_remove_ads · 移除头像页横幅跳转 = type=http-response, pattern=(?i)^https:\/\/api\.fzxhmy\.com\/avatar\/landing\?, script-path=https://raw.githubusercontent.com/Yjwj205/surge-modules/main/kelee/scripts/JavaScript/iWallBiZhi/landing.js, requires-body=1, max-size=-1

[MITM]
hostname = %APPEND% api.fzxhmy.com
