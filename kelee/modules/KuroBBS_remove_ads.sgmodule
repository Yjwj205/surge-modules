#!name=库街区去广告
#!desc=移除开屏广告、弹窗广告、搜索页面的热搜及话题热榜。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/KuroBBS.png
#!category=去广告

[Map Local]
(?i)^https:\/\/api\.kurobbs\.com\/config\/getOpenScreen$ data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/api\.kurobbs\.com\/config\/index\/windows$ data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/api\.kurobbs\.com\/config\/search\/getSearchConfig\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/api\.kurobbs\.com\/forum\/app\/topic\/hotlist\? data-type=text data="{}" header="Content-Type:application/json" status-code=200

[MITM]
hostname = %APPEND% api.kurobbs.com
