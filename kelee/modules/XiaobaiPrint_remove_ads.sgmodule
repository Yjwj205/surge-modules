#!name=小白智慧打印去广告
#!desc=移除开屏广告、首页推广金刚位、热门内容推荐、横幅广告、搜索填充词、搜索发现，精简我的页面。账户页面错误是已知问题，无需反馈。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/XiaobaiPrint.png
#!category=去广告

[Rule]
DOMAIN, ad.lovefree.cc, REJECT
DOMAIN-SUFFIX, adwanji.com, REJECT

[Body Rewrite]
http-response-jq (?i)^https:\/\/epbox\.gongfudou\.com\/graphql$ 'del(.data.mallConsumables) | del(.data.currentUser.goodsCoupons)'
http-response-jq (?i)^https:\/\/epbox\.gongfudou\.com\/graphql$ 'if .data.systemConfig.searchHotTags? then del(.data.systemConfig) else . end'
http-response-jq (?i)^https:\/\/epbox\.gongfudou\.com\/graphql$ 'if (.data.page.__typename=="Page" and .data.page.name=="场景化改版 2024") then .data.page.firstTabDetail.floors|=map(select(.numType=="row")) else . end'

[Map Local]
(?i)^https:\/\/epbox\.gongfudou\.com\/big_data\/v\d\/banners\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/epbox\.gongfudou\.com\/big_data\/v\d\/canvas\/query_actions\? data-type=text data="{}" header="Content-Type:application/json" status-code=200

[MITM]
hostname = %APPEND% epbox.gongfudou.com, epbox.gongfudou.com
