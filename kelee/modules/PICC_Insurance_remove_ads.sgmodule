#!name=中国人保去广告
#!desc=移除中国人保开屏广告和应用内广告
#!author=Sliverkiss[https://github.com/Sliverkiss]
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/PICC_Insurance.png
#!category=去广告

[Map Local]
(?i)^https:\/\/zgrb\.epicc\.com\.cn\/G-HAPP\/h\/headlines\/queryHeadlines data-type=text data="" status-code=404
(?i)^https:\/\/zgrb\.epicc\.com\.cn\/G-HAPP\/a\/update\/startupPage\/v1 data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/zgrb\.epicc\.com\.cn\/G-HAPP\/a\/config\/guessYouLike\/v3 data-type=text data="{}" header="Content-Type:application/json" status-code=200

[Script]
PICC_Insurance_remove_ads · 移除主页推广 = type=http-response, pattern=(?i)^https:\/\/zgrb\.epicc\.com\.cn\/G-HAPP\/a\/config\/homeInit\/v3, script-path=https://raw.githubusercontent.com/Yjwj205/surge-modules/main/kelee/scripts/JavaScript/PICC_Insurance/PICC_Insurance_remove_ads.js, requires-body=1, max-size=-1
PICC_Insurance_remove_ads · 移除我的页面推广 = type=http-response, pattern=(?i)^https:\/\/zgrb\.epicc\.com\.cn\/G-HAPP\/mpageconfig\/myPageConfigList\/v3, script-path=https://raw.githubusercontent.com/Yjwj205/surge-modules/main/kelee/scripts/JavaScript/PICC_Insurance/PICC_Insurance_remove_ads.js, requires-body=1, max-size=-1

[MITM]
hostname = %APPEND% zgrb.epicc.com.cn
