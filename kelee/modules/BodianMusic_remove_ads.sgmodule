#!name=波点音乐去广告
#!desc=精简应用配置，禁用P2P传输。移除开屏广告、横幅推广、悬浮广告、歌曲广告、商城入口、搜索推广、评论区推广、试听语音提醒。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/BodianMusic.png
#!category=去广告

[Body Rewrite]
http-response-jq (?i)^https:\/\/bd-api\.kuwo\.cn\/api\/service\/conf\/all\? 'del(.data.groupSign.adStartAppDialog) | del(.data.groupSign.adGuideTest) | del(.data.groupSign.playTips) | del(.data.groupSign.adExitChange) | del(.data.conf.adGuidePopCount) | del(.data.conf.adDownListOpen)'
http-response-jq (?i)^https:\/\/bd-api\.kuwo\.cn\/api\/service\/conf\/all\? '.data.conf.flowControlConfig.uploadEnable = false | .data.conf.flowControlConfig.p2pEnable = false'
http-response-jq (?i)^https:\/\/ab-bodian\.kuwo\.cn\/abtest\/ui\/info\? 'del(.data.mapTestInfo.CommentADPosition) | del(.data.mapTestInfo.DiscoverADPosition) | del(.data.mapTestInfo.DownloadAd) | del(.data.mapTestInfo.FreeModVoiceReminder) | del(.data.mapTestInfo.GamesTrans) | del(.data.mapTestInfo.bodianmvdialog) | del(.data.mapTestInfo.MvTryShowAds) | del(.data.mapTestInfo.insert)'
http-response-jq (?i)^https:\/\/bd-api\.kuwo\.cn\/api\/service\/global\/config\/scene\? 'del(.data.iosP2PCacheEnable) | del(.data.warmStartDialog) | del(.data.adsNotFinishVipPop4DayInterval)'
http-response-jq (?i)^https:\/\/bd-api\.kuwo\.cn\/api\/service\/global\/config\/scene\? '.data.showShopEntry = false | .data.iosP2pEnableSendDataLimit = 1'
http-response-jq (?i)^https:\/\/bd-api\.kuwo\.cn\/api\/search\/topic\/word\/list\? 'del(.data.hotTopic) | del(.data.searchFind) | del(.data.globalJumpInfo) | del(.data.hotWord)'
http-response-jq (?i)^https:\/\/bd-api\.kuwo\.cn\/api\/service\/home\/index\? '.data.moduleList |= map(select(.type | tostring | (. != "8" and . != "1")))'
http-response-jq (?i)^https:\/\/bd-api\.kuwo\.cn\/api\/service\/music\/recommendList\? '.data.musicList[] |= del(.showAd)'
http-response-jq (?i)^https:\/\/bd-api\.kuwo\.cn\/api\/comments\/v3\/topInfo\? 'del(.data.putao) | del(.data.bannerVos)'

[Map Local]
(?i)^https:\/\/bd-api\.kuwo\.cn\/api\/(play|service|advert)\/advert\/ data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/bd-api\.kuwo\.cn\/api\/service\/banner\/ data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/bd-api\.kuwo\.cn\/api\/ucenter\/vip\/give\/config\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/bd-api\.kuwo\.cn\/api\/service\/home\/module\?.*&moduleId=6 data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/bd-api\.kuwo\.cn\/api\/pay\/vip\/lowPriceText\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/bd-api\.kuwo\.cn\/api\/service\/global\/config\/vipEnter\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/bd-api\.kuwo\.cn\/api\/popup\/ data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/bd-api\.kuwo\.cn\/api\/pay\/vip\/invitation\/swell\/popup\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/bd-api\.kuwo\.cn\/api\/service\/version\/popup\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/bd-api\.kuwo\.cn\/api\/pay\/vip\/invitation\/assist\/popup\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/bd-api\.kuwo\.cn\/api\/pay\/h5\/common\/popup\? data-type=text data="{}" header="Content-Type:application/json" status-code=200

[MITM]
hostname = %APPEND% bd-api.kuwo.cn
