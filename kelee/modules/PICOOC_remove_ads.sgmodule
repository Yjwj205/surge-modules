(?i)^https:\/\/api2\.picooc\.com\/program\/listMainProgram\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/a\.picooc\.com\/v\d\/api\/camp\/sys\/config\/coupon\/pattern\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/api2\.picooc\.com\/v\d\/api\/account\/getTabsInfo\? data-type=text data="{}" header="Content-Type:application/json" status-code=200

[MITM]
hostname = %APPEND% api2.picooc.com, a.picooc.com
