#!name=YouTube双语翻译
#!desc=字幕增强及双语翻译，支持Youtube Music歌词翻译。此插件需要置于YouTube去广告插件之下，且和YouTube去广告插件的歌词翻译冲突，不支持tvOS设备。
#!author=VirgilClyne[https://github.com/VirgilClyne]
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/YouTube.png
#!category=功能增强
#!arguments=Type:Official,AutoCC:true,ShowOnly:true,Position:Forward
#!arguments-desc=[Type] 字幕类型 / [AutoCC] 自动显示翻译字幕 / [ShowOnly] 仅显示“自动翻译”字幕 / [Position] 原文字幕位置

[Script]
YouTubeSubtitlesTranslation · JSON·YouTube播放器请求 = type=http-request, pattern=(?i)^https?:\/\/(www|m|tv)\.youtube\.com\/youtubei\/v1\/player\?(.*), script-path=https://raw.githubusercontent.com/Yjwj205/surge-modules/main/kelee/scripts/JavaScript/YouTube/YouTube_Subtitles_Translate/YouTube_Subtitles_request.js, argument="Type={{{Type}}}&AutoCC={{{AutoCC}}}&ShowOnly={{{ShowOnly}}}&Position={{{Position}}}", requires-body=1, max-size=-1
YouTubeSubtitlesTranslation · JSON·YouTube播放器响应 = type=http-response, pattern=(?i)^https?:\/\/(www|m|tv)\.youtube\.com\/youtubei\/v1\/player\?(.*), script-path=https://raw.githubusercontent.com/Yjwj205/surge-modules/main/kelee/scripts/JavaScript/YouTube/YouTube_Subtitles_Translate/YouTube_Subtitles_response.js, argument="Type={{{Type}}}&AutoCC={{{AutoCC}}}&ShowOnly={{{ShowOnly}}}&Position={{{Position}}}", requires-body=1, max-size=-1
YouTubeSubtitlesTranslation · Proto·YouTube播放器请求 = type=http-request, pattern=(?i)^https?:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/player\?(.*), script-path=https://raw.githubusercontent.com/Yjwj205/surge-modules/main/kelee/scripts/JavaScript/YouTube/YouTube_Subtitles_Translate/YouTube_Subtitles_request.js, argument="Type={{{Type}}}&AutoCC={{{AutoCC}}}&ShowOnly={{{ShowOnly}}}&Position={{{Position}}}", requires-body=1, binary-body-mode=1, max-size=-1
YouTubeSubtitlesTranslation · Proto·YouTube播放器响应.proto = type=http-response, pattern=(?i)^https?:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/player\?(.*), script-path=https://raw.githubusercontent.com/Yjwj205/surge-modules/main/kelee/scripts/JavaScript/YouTube/YouTube_Subtitles_Translate/YouTube_Subtitles_response.js, argument="Type={{{Type}}}&AutoCC={{{AutoCC}}}&ShowOnly={{{ShowOnly}}}&Position={{{Position}}}", requires-body=1, binary-body-mode=1, max-size=-1
YouTubeSubtitlesTranslation · Proto·GetWatch响应 = type=http-response, pattern=(?i)^https?:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/get_watch\?(.*), script-path=https://raw.githubusercontent.com/Yjwj205/surge-modules/main/kelee/scripts/JavaScript/YouTube/YouTube_Subtitles_Translate/YouTube_Subtitles_response.js, argument="Type={{{Type}}}&AutoCC={{{AutoCC}}}&ShowOnly={{{ShowOnly}}}&Position={{{Position}}}", requires-body=1, binary-body-mode=1, max-size=-1
YouTubeSubtitlesTranslation · YouTube定时文本请求 = type=http-request, pattern=(?i)^https?:\/\/(www|m)\.youtube\.com\/api\/timedtext\?(.*), script-path=https://raw.githubusercontent.com/Yjwj205/surge-modules/main/kelee/scripts/JavaScript/YouTube/YouTube_Subtitles_Translate/YouTube_Subtitles_request.js, argument="Type={{{Type}}}&AutoCC={{{AutoCC}}}&ShowOnly={{{ShowOnly}}}&Position={{{Position}}}"
YouTubeSubtitlesTranslation · YouTube合成定时文本响应 = type=http-response, pattern=(?i)^https?:\/\/(www|m)\.youtube\.com\/api\/timedtext\?(.*)subtype=(Official|External), script-path=https://raw.githubusercontent.com/Yjwj205/surge-modules/main/kelee/scripts/JavaScript/YouTube/YouTube_Subtitles_Translate/YouTube_Composite_Subtitles_response.js, requires-body=1, max-size=-1
YouTubeSubtitlesTranslation · YouTube翻译定时文本响应 = type=http-response, pattern=(?i)^https?:\/\/(www|m)\.youtube\.com\/api\/timedtext\?(.*)subtype=Translate, script-path=https://raw.githubusercontent.com/Yjwj205/surge-modules/main/kelee/scripts/JavaScript/YouTube/YouTube_Subtitles_Translate/YouTube_Subtitles_Translate_response.js, requires-body=1, max-size=-1
YouTubeSubtitlesTranslation · JSON·YouTube Music浏览请求 = type=http-request, pattern=(?i)^https?:\/\/music\.youtube\.com\/youtubei\/v1\/browse\?(.*), script-path=https://raw.githubusercontent.com/Yjwj205/surge-modules/main/kelee/scripts/JavaScript/YouTube/YouTube_Subtitles_Translate/YouTube_Subtitles_request.js, argument="Type={{{Type}}}&AutoCC={{{AutoCC}}}&ShowOnly={{{ShowOnly}}}&Position={{{Position}}}", requires-body=1, max-size=-1
YouTubeSubtitlesTranslation · Proto·YouTube Music浏览请求 = type=http-request, pattern=(?i)^https?:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/browse\?(.*), script-path=https://raw.githubusercontent.com/Yjwj205/surge-modules/main/kelee/scripts/JavaScript/YouTube/YouTube_Subtitles_Translate/YouTube_Subtitles_request.js, argument="Type={{{Type}}}&AutoCC={{{AutoCC}}}&ShowOnly={{{ShowOnly}}}&Position={{{Position}}}", requires-body=1, binary-body-mode=1, max-size=-1
YouTubeSubtitlesTranslation · JSON·YouTube Music翻译歌词响应 = type=http-response, pattern=(?i)^https?:\/\/music\.youtube\.com\/youtubei\/v1\/browse\?(.*)subtype=Translate, script-path=https://raw.githubusercontent.com/Yjwj205/surge-modules/main/kelee/scripts/JavaScript/YouTube/YouTube_Subtitles_Translate/YouTube_Subtitles_Translate_response.js, requires-body=1, max-size=-1
YouTubeSubtitlesTranslation · Proto·YouTube Music翻译歌词响应 = type=http-response, pattern=(?i)^https?:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/browse\?(.*)subtype=Translate, script-path=https://raw.githubusercontent.com/Yjwj205/surge-modules/main/kelee/scripts/JavaScript/YouTube/YouTube_Subtitles_Translate/YouTube_Subtitles_Translate_response.js, requires-body=1, binary-body-mode=1, max-size=-1

[MITM]
hostname = %APPEND% www.youtube.com, m.youtube.com, tv.youtube.com, music.youtube.com, youtubei.googleapis.com
