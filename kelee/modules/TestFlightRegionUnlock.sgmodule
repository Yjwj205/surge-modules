#!name=TestFlight地区解锁
#!desc=解除TestFlight的区域限制，支持tvOS。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/TestFlight.png
#!category=功能增强
#!arguments=policy:PROXY
#!arguments-desc=[policy] 策略

[Rule]
DOMAIN, testflight.apple.com,{{{policy}}}

[Body Rewrite]
http-request (?i)^https?:\/\/testflight\.apple\.com\/v\d\/accounts\/.+?\/install$ "storefrontId"\x20:\x20"\d{6}-\d{2},\d{2}", "storefrontId":"143441-19,29",

[MITM]
hostname = %APPEND% testflight.apple.com
