#!name=得间小说去广告
#!desc=移除开屏广告、章末广告，移除扉页广告提示、听书界面广告提示、搜索栏填充词。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/iReaderDejian.png
#!category=去广告

[Rule]
DOMAIN, smad.ms.zhangyue.net, REJECT
DOMAIN, saad.ms.zhangyue.net, REJECT

[Body Rewrite]
http-response-jq (?i)^https:\/\/dj\.palmestore\.com\/zybk\/api\/powerup\/userGroup\? 'del(.body.sevenDaysAd) | del(.body.shortPlayShow) | del(.body.sdkShortPlayAB)'
http-response-jq (?i)^https:\/\/dj\.palmestore\.com\/zybk\/api\/search\/index\? 'del(.body.keywords)'

[Map Local]
(?i)^https:\/\/dj\.palmestore\.com\/djad\/ data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/dj\.palmestore\.com\/zybk\/api\/ad\/ data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/dj\.palmestore\.com\/zyapi\/bookstore\/ad\/ data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/dj\.palmestore\.com\/zybk\/api\/bookshelf\/index\? data-type=text data="{}" header="Content-Type:application/json" status-code=200

[MITM]
hostname = %APPEND% dj.palmestore.com
