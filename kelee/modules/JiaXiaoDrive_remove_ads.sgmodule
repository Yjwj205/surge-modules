#!name=驾校一点通去广告
#!desc=移除开屏广告、各页面广告横幅、弹窗广告，移除社区广告。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/JiaXiaoDrive.png
#!category=去广告

[Body Rewrite]
http-response-jq (?i)http-response 'del(."^https:\\/\\/api\\"."ksedt\\"."com\\/api\\/config\\/")'

[Map Local]
(?i)^https:\/\/richmanrules\.ksedt\.com\/serverConfig\/3\/adConfig\.json data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/gouche\.ksedt\.com\/config\/popup\/info$ data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/richmanrules\.ksedt\.com\/intellectWaterfallBidding\/find$ data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/op\.ksedt\.com\/jxedtLive\/liveIntroduceResource data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/richmanrules\.ksedt\.com\/intellectWaterfall\/find$ data-type=text data="{}" header="Content-Type:application/json" status-code=200

[MITM]
hostname = %APPEND% richmanrules.ksedt.com, gouche.ksedt.com, muses.ksedt.com, op.ksedt.com, api.ksedt.com
