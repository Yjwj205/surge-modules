#!name=纷玩岛去广告
#!desc=移除开屏广告、弹窗广告、信息横幅推广、票夹页面横幅广告。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/LiveLab.png
#!category=去广告

[Body Rewrite]
http-response-jq (?i)^https:\/\/api\.livelab\.com\.cn\/appShow\/app\/homepage\/modules\?tabId=5$ '.data |= map(select(.id | IN(51, 52, 81, 82, 83, 84)))'

[Map Local]
(?i)^https:\/\/api\.livelab\.com\.cn\/pgc\/advert\/ data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/api\.livelab\.com\.cn\/search\/appHotWords\/app\/queryHotWords$ data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/api\.livelab\.com\.cn\/appShow\/hotSearch\/app\/rankList$ data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/api\.livelab\.com\.cn\/appShow\/app\/homepage\/banners\?bannerModuleId=(82|84|53) data-type=text data="{}" header="Content-Type:application/json" status-code=200

[MITM]
hostname = %APPEND% api.livelab.com.cn
