#!name=百度贴吧去广告
#!desc=移除开屏广告、信息流广告和帖内广告，精简侧拉抽屉及我的页面。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md], app2smile[https://github.com/app2smile]
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Tieba.png
#!category=去广告
#!arguments=per_filter_video_thread:true
#!arguments-desc=[per_filter_video_thread] 拦截推荐页面视频帖

[Rule]
DOMAIN, 180.76.76.200, REJECT
IP-CIDR, 180.76.76.200/32, REJECT, no-resolve

[Body Rewrite]
http-response-jq (?i)^https?:\/\/tiebac\.baidu\.com\/c\/s\/sync$ 'del(.activity_switch) | del(.video_report_config) | del(.advertisement_config) | del(.next_start) | del(.push_strategy_new) | del(.live_activity_guide) | del(.h5_pop_ups) | del(.duxiaoman_url) | del(.is_need_remind_live_rooms) | del(.floating_icon) | del(.ad_stlog_switch) | del(.first_time_motivate) | del(.windowStrategyList) | del(.ad_adsense) | del(.ad_config) | del(.videoup_guide_pop) | del(.ad_origin_config_switch) | del(.needNewUserLead) | del(.h5_pop_ups_config) | del(.alaTabColor) | del(.search_guide) | del(.ad_sdk_priority) | del(.low_version_pop_config) | del(.ad_num_competition_frs) | del(.live_new_user_guide_day) | del(.screen_fill_data_result) | del(.yy_live_tab) | del(.ad_num_competition_personalize) | del(.complete_apk_url) | del(.user_activity) | del(.homepage_guide) | del(.bottom_bubble_config) | del(.home_screen_ad) | del(.afSearch_tab) | del(.recent_client_info) | del(.video_activity) | del(.namoaixud_url) | del(.yy_live_config) | del(.user_growth_task_list) | del(.cloud_control_data_info) | del(.wl_config.pb_banner_funad_cache_strategy) | del(.wl_config.pb_comment_asyncafd_cache_strategy) | del(.wl_config.download_edge_float) | del(.wl_config.download_pause_retain_dialog_conf) | del(.wl_config.download_mobile_dialog_conf) | del(.wl_config.download_fake_progress_config_a) | del(.wl_config.download_fake_progress_config_b) | del(.scheme_whitelist)'
http-response-jq (?i)^https?:\/\/tiebac\.baidu\.com\/c\/s\/sync$ '.wl_config.home_ad_num = 0 | .wl_config.frs_ad_num = 0 | .wl_config.pb_comment_ad_num = 0 | .wl_config.index_bear_density = 0 | .wl_config.frs_bear_density = 0 | .wl_config.index_bear_first_floor_max = 999999999 | .wl_config.index_bear_first_floor_min = 999999999'
http-response-jq (?i)^https?:\/\/tiebac\.baidu\.com\/c\/s\/sync$ '.index_tab_info |= map(select(.tab_name == "推荐")) | .top_level_navi |= {"推荐": .["推荐"], "侧边栏": .["侧边栏"], "关注": .["关注"]}'
http-response-jq (?i)^https?:\/\/tiebac\.baidu\.com\/c\/u\/user\/profile$ 'del(.url_map) | del(.user_agent_info) | del(.bubble_info) | del(.duxiaoman_entry) | del(.uc_card) | del(.finance_tab) | del(.vip_banner) | del(.ala_live_info) | del(.recom_naws_list) | del(.duxiaoman) | del(.user.consume_info) | del(.namoaixud_entry)'
http-response-jq (?i)^https?:\/\/tiebac\.baidu\.com\/c\/u\/user\/profile$ '.user.shake_ad_switch.is_show = 0'
http-response-jq (?i)^https?:\/\/tiebac\.baidu\.com\/c\/u\/user\/profile$ '.custom_grid |= map(select(.title != "游戏大厅" and .title != "预约管理" and .title != "领话费" and .title != "短故事")) | .zone_info |= map(.common_func |= (if .common_func_noraml then .common_func_noraml |= map(select(.name != "创建智能体")) else . end)) | .zone_info |= map(select(.type != "commerce" and .type != "banner" and .type != "game"))'
http-response-jq (?i)^https?:\/\/tieba\.baidu\.com\/c\/f\/forum\/forumGuide$ 'del(.hot_search)'
http-response-jq (?i)^https?:\/\/tieba\.baidu\.com\/c\/f\/frs\/frsBottom\? 'del(.card_activity)'
http-response-jq (?i)^https?:\/\/tiebac\.baidu\.com\/c\/f\/frs\/frsBottom$ 'del(.card_activity)'
http-response-jq (?i)^https?:\/\/tiebac\.baidu\.com\/c\/f\/sidebar\/home$ 'del(.game_center) | del(.tools) | del(.task_list) | del(.vip_banner)'

[Map Local]
(?i)^https?:\/\/tiebac\.baidu\.com\/c\/f\/forum\/getInterestClassList$ data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https?:\/\/tiebac\.baidu\.com\/c\/f\/search\/discover$ data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https?:\/\/tieba\.baidu\.com\/mo\/q\/search\/startPage\? data-type=base64 data="eyJubyI6MCwiZXJyb3IiOiJzdWNjZXNzIn0=" header="Content-Type:application/json" status-code=200
(?i)^https?:\/\/tieba\.baidu\.com\/c\/f\/search\/discover$ data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/tieba\.baidu\.com\/c\/f\/forum\/getForumAlbum$ data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^http:\/\/c\.tieba\.baidu\.com\/c\/f\/forum\/hotforum$ data-type=text data="{}" header="Content-Type:application/json" status-code=200

[Script]
Tieba_remove_ads · ProtoBuf处理 = type=http-response, pattern=(?i)^https?:\/\/tieba(?:c)?\.baidu\.com\/c\/(f\/excellent\/personalized|f\/frs\/page|b\/ad\/adBid|f\/ad\/getFeedAd|f\/pb\/page|f\/frs\/generalTabList)\?cmd=\d+&format=protobuf, script-path=https://raw.githubusercontent.com/Yjwj205/surge-modules/main/kelee/scripts/JavaScript/Tieba/tieba-proto.js, argument="per_filter_video_thread={{{per_filter_video_thread}}}", requires-body=1, binary-body-mode=1, max-size=-1, timeout=10

[MITM]
hostname = %APPEND% tiebac.baidu.com, tieba.baidu.com
