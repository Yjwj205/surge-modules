(?i)^https:\/\/thor\.weidian\.com\/ares\/app\.dialog\/ data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/thor\.weidian\.com\/warlock\/recommend\.guessULike\/ data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/thor\.weidian\.com\/feedserver\/feed\.similarRecFeeds\/ data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/thor\.weidian\.com\/faith\/search\.hotRecShadowWord\/ data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/thor\.weidian\.com\/faith\/search\.getProcessTopics\/ data-type=text data="{}" header="Content-Type:application/json" status-code=200
