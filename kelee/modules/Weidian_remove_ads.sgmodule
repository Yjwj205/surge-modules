[Script]
Weidian_remove_ads · 配置修改 = type=http-response, pattern=(?i)^https:\/\/thor\.weidian\.com\/appconf\/getAppConfig\/, script-path=https://raw.githubusercontent.com/Yjwj205/surge-modules/main/kelee/scripts/JavaScript/Weidian/getAppConfig.js, requires-body=1, binary-body-mode=1, max-size=-1
Weidian_remove_ads · 精简钱包区 = type=http-response, pattern=(?i)^https:\/\/thor\.weidian\.com\/wgs\/wallet\.query\.order\.entrance\/, script-path=https://raw.githubusercontent.com/Yjwj205/surge-modules/main/kelee/scripts/JavaScript/Weidian/wallet.js, requires-body=1, binary-body-mode=1, max-size=-1

[MITM]
hostname = %APPEND% thor.weidian.com
