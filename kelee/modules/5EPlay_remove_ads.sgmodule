#!name=5EPlay去广告
#!desc=移除开屏广告、弹窗广告、活动角标、商城。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/5EPlay.png
#!category=去广告

[Body Rewrite]
http-response-jq (?i)^https:\/\/app\.5eplay\.com\/api\/app\/dync_config\? 'del(.data.function_configs.startup_ad_switch) | del(.data.function_configs.startup_ad_timeout) | del(.data.function_configs.startup_ad_day_max) | del(.data.function_configs.app_bar_guide_width) | del(.data.function_configs.app_bar_guide_height) | del(.data.function_configs.app_bar_guide_url) | del(.data.function_configs.app_bar_guide_time) | del(.data.function_configs.home_tab_event_tag) | del(.data.function_configs.home_tab_event_tag_ext) | del(.data.function_configs.home_tab_player_tag) | del(.data.function_configs.home_tab_player_tag_ext) | del(.data.function_configs.task_center_entrance) | del(.data.function_configs.store_go) | del(.data.function_configs.wall_closed)'
http-response-jq (?i)^https:\/\/app\.5eplay\.com\/api\/index\/tab_v\d\?category_id=tab_1&page=\d$ 'del(.data.float_advertise)'
http-response-jq (?i)^https:\/\/ya-api-app\.5eplay\.com\/v\d\/search\/config$ 'del(.data.placeholder)'

[Map Local]
(?i)^https:\/\/ya-api-app\.5eplay\.com\/v\d\/search\/kwd_top$ data-type=text data="{}" header="Content-Type:application/json" status-code=200

[MITM]
hostname = %APPEND% app.5eplay.com, ya-api-app.5eplay.com
