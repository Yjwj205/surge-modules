#!name=美颜相机去广告
#!desc=移除开屏广告、应用内弹窗，精简首页和我的页面。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/MeituMYXJ.png
#!category=去广告

[Rule]
DOMAIN, adui.tg.meitu.com, REJECT

[Body Rewrite]
http-response-jq (?i)^https:\/\/api\.meiyan\.com\/operation\/get_config\.json\? 'del(.response.time_limit) | del(.response.bubble) | del(.response.person_center)'
http-response-jq (?i)^https:\/\/api\.meiyan\.com\/operation\/get_config\.json\? '.response.function_pop.meiyan_style.is_pop = false | .response.onoff.vip_half_window_exit_remain_popup.open = 0 | .response.onoff.vip_home_exit_remain_popup = 0'

[Map Local]
(?i)^https:\/\/api\.meiyan\.com\/operation\/home_banner\.json\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/api\.meiyan\.com\/vip\/permission_update_popup\.json\? data-type=text data="{}" header="Content-Type:application/json" status-code=200

[Script]
MeituMYXJ_remove_ads · 精简首页功能栏目并移除美颜推荐 = type=http-response, pattern=(?i)^https:\/\/api\.meiyan\.com\/operation\/home\.json\?, script-path=https://raw.githubusercontent.com/Yjwj205/surge-modules/main/kelee/scripts/JavaScript/MeituMYXJ/MeituMYXJ_remove_ads.js, requires-body=1, max-size=-1

[MITM]
hostname = %APPEND% api.meiyan.com
