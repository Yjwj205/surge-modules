#!name=雪球去广告
#!desc=移除开屏广告、各类横幅广告、信息流广告、帖内广告、新用户定向广告、各类弹窗、股票精选推荐、基金精选推荐、聪明的投资者推荐、私募推荐、直播推荐。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Snowball.png
#!category=去广告

[Body Rewrite]
http-response-jq (?i)^https:\/\/open\.xueqiu\.com\/mpaas\/config\/content\?.*timeline_tab_name 'del(.data.im_notice_show) | del(.data.request_notice_show) | del(.data.timeline_tab_name) | del(.data.profileMenuConfig_anonymous_V12) | del(.data.trade_open_account_promotion_url) | del(.data.trade_unify_open_account_list) | del(.data.community_ad_download_msg) | del(.data.home_tab_dynamic) | del(.data.home_tab_dynamic_before) | del(.data.home_tab_dynamic_after) | del(.data.isitor_page_login_config) | del(.data.open_wechat_mini_app_config) | del(.data.user_guide_contact_config) | del(.data.brokers_router_config) | del(.data.my_page_right_items)'

