#!name=天气通去广告
#!desc=移除开屏广告、横幅广告、弹窗广告，精简底栏及我的页面。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/TianQiTong.png
#!category=去广告

[Body Rewrite]
http-response-jq (?i)^https:\/\/tqt\.weibo\.cn\/master\/nav\/tab\? 'map(.tabs|=map(select(.type=="weather" or .type=="radar" or .type=="my")))'

[Map Local]
(?i)^https:\/\/forecast\.sina\.cn\/app\/overall\/switch\.php\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/tqt\.weibo\.cn\/business\/advert\/ data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/tqt\.weibo\.cn\/user\/device\/ad_multi_star\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/tqt\.weibo\.cn\/operation\/activity\/ data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/tqt\.weibo\.cn\/api\/user\/user\/\d\.\d\/\?method=personal_center$ data-type=text data="{}" header="Content-Type:application/json" status-code=200

[MITM]
hostname = %APPEND% forecast.sina.cn, tqt.weibo.cn
