#!name=闪动校园去广告
#!desc=精简首页和底部导航
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/ShandongSchool.png
#!category=去广告

[Body Rewrite]
http-response-jq (?i)^https:\/\/api\.huachenjie\.com\/run-front\/home\/homePage\/config$ '.data.functionEntries |= map(select(.name == "运动" or .name == "空间")) | del(.data.seaview)'
http-response-jq (?i)^https:\/\/api\.huachenjie\.com\/run-front\/api\/user\/cs\/index$ 'del(.data.bannerList)'
http-response-jq (?i)^https:\/\/api\.huachenjie\.com\/run-front\/common\/bottom-bar\/redDot$ 'del(.data.inspiration)'

[Map Local]
(?i)^https:\/\/api\.huachenjie\.com\/run-front\/ad\/ data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/api\.huachenjie\.com\/run-front\/api\/union\/ad\/ data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/api\.huachenjie\.com\/run-front\/home\/getAdPopup$ data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/api\.huachenjie\.com\/run-front\/street\/listRecommendBanner$ data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/api\.huachenjie\.com\/run-front\/street\/listThemeBanner$ data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/api\.huachenjie\.com\/run-front\/api\/home\/activityEntry$ data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/api\.huachenjie\.com\/run-front\/home\/promoSlots\/config$ data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/api\.huachenjie\.com\/run-front\/api\/channel\/subject\/hotspot\/rank$ data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/api\.huachenjie\.com\/run-front\/api\/jackpot\/award\/home$ data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/api\.huachenjie\.com\/run-front\/api\/jackpot\/award\/lotteryPage$ data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/api\.huachenjie\.com\/run-front\/api\/jackpot\/award\/list$ data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/api\.huachenjie\.com\/run-front\/api\/mall\/goods\/recommend\/pagePointsGoodsList$ data-type=text data="{}" header="Content-Type:application/json" status-code=200

[MITM]
hostname = %APPEND% api.huachenjie.com
