#!name=微信公众号去广告
#!desc=过滤微信公众号广告
#!author=RuCu6[https://github.com/RuCu6]
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Weixin.png
#!category=去广告

[Rule]
DOMAIN-SUFFIX, wxs.qq.com, REJECT

[Map Local]
(?i)^https:\/\/mp\.weixin\.qq\.com\/mp\/(cps_product_info|getappmsgad|jsmonitor|masonryfeed|relatedarticle)\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/mp\.weixin\.qq\.com\/mp\/relatedsearchword data-type=text data="{}" header="Content-Type:application/json" status-code=200

[MITM]
hostname = %APPEND% mp.weixin.qq.com
