#!name=快递100去广告
#!desc=移除横幅广告、弹窗广告，精简首页。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/KuaiDi100.png
#!category=去广告

[Body Rewrite]
http-response-jq (?i)^https?:\/\/p\.kuaidi100\.com\/mobile\/mobileapi\.do$ 'del(.adsplash) | del(.adIsConsumable) | del(.adProductId) | del(.nologin_tips) | del(.index_banner) | del(.me_banner) | del(.index_banner_shadow) | del(.adshongbao) | del(.adsapp_homepage_ticket_pop) | del(.adsoptimizationsend) | del(.adsapp_activity_ad_array) | del(.adbanner) | del(.adposition) | del(.adShowAgainTime)'
http-response-jq (?i)^https?:\/\/p\.kuaidi100\.com\/apicenter\/xcx\.dox 'del(.data.secondMenuList)'

[Map Local]
(?i)^https?:\/\/p\.kuaidi100\.com\/advertisement\/ data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https?:\/\/p\.kuaidi100\.com\/e-commerce\/act\/actInfo\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https?:\/\/p\.kuaidi100\.com\/apicenter\/card\.dox data-type=text data="{}" header="Content-Type:application/json" status-code=200

[MITM]
hostname = %APPEND% p.kuaidi100.com
