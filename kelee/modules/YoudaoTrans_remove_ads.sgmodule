[Map Local]
(?i)^https:\/\/gorgon\.youdao\.com\/gorgon\/v2\/request\.s data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/gorgon\.youdao\.com\/gorgon\/brand\/prefetch\.s data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/gorgon\.youdao\.com\/gorgon\/request\.s data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/fanyiguan-server\.youdao\.com\/server\/banner\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/dict\.youdao\.com\/vip\/activity\/fanyiguan\/sevendayfree\/imei\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/dict\.youdao\.com\/wordbook\/recommend\?all=false data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/api-overmind\.youdao\.com\/openapi\/get\/luna\/dict\/trans_abtest\/online\/iOS\? data-type=text data="{}" header="Content-Type:application/json" status-code=200

[MITM]
hostname = %APPEND% gorgon.youdao.com, fanyiguan-server.youdao.com, api-overmind.youdao.com, dict.youdao.com
