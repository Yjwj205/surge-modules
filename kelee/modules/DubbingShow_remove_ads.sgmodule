#!name=配音秀去广告
#!desc=移除开屏广告、弹窗、横幅、各类关注推荐。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/DubbingShow.png
#!category=去广告

[Body Rewrite]
http-response-jq (?i)^https:\/\/iosapi\.peiyinxiu\.com\/Api\/live\/LiveList 'del(.data.banners)'
http-response-jq (?i)^https:\/\/iosapi\.peiyinxiu\.com\/api\/live\/FollowList 'del(.obj.data)'
http-response-jq (?i)^https:\/\/iosapi\.peiyinxiu\.com\/Api\/Friend\/GetRecommendUsers 'del(.obj.data)'
http-response-jq (?i)^https:\/\/iosapi\.peiyinxiu\.com\/api\/Union\/HomeData 'del(.obj.data)'

[Script]
DubbingShow_remove_ads · 移除首页底部弹窗 = type=http-response, pattern=(?i)^https:\/\/iosapi\.peiyinxiu\.com\/Api\/Film\/GetConfigValue, script-path=https://raw.githubusercontent.com/Yjwj205/surge-modules/main/kelee/scripts/JavaScript/DubbingShow/DubbingShow_remove_ads.js, requires-body=1, max-size=-1

[MITM]
hostname = %APPEND% iosapi.peiyinxiu.com
