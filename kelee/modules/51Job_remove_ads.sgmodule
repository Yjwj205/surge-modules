#!name=前程无忧去广告
#!desc=移除开屏广告、弹窗、信息流推广、职位页面推广和各类横幅推广。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/51Job.png
#!category=去广告

[Body Rewrite]
http-response-jq (?i)^https:\/\/cupid\.51jobapp\.com\/open\/noauth\/recommend\/job-tab-dynamic\? 'del(.resultbody.adsTabFeeds)'
http-response-jq (?i)^https:\/\/cupid\.51jobapp\.com\/open\/user-task\/user\/task\/ 'del(.resultbody.availableTaskList)'
http-response-jq (?i)^https:\/\/cupid\.51jobapp\.com\/open\/tab\/good-job\/modules\? 'del(.resultbody.bannerList)'

[Map Local]
(?i)^https:\/\/appapi\.51jobapp\.com\/api\/market\/get_launch\.php\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/cupid\.51jobapp\.com\/open\/operation\/get\/latest\/banner-list\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/cupid\.51jobapp\.com\/open\/51job-activities\/secJob\/queryHomeSecondConfigV2\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/cupid\.51jobapp\.com\/open\/noauth\/jobs\/detail\/sesame-competitive\/ data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/cupid\.51jobapp\.com\/open\/noauth\/jobs\/job-detail\/user-rights\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/cupid\.51jobapp\.com\/open\/resume\/strategy\/resume-build\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/cupid\.51jobapp\.com\/launch-hub\/open\/noauth\/popUp\/ data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/cupid\.51jobapp\.com\/launch-hub\/open\/noauth\/popUp\/getHomePagePopUp\? data-type=text data="{}" header="Content-Type:application/json" status-code=200

[MITM]
hostname = %APPEND% appapi.51jobapp.com, cupid.51jobapp.com
