#!name=蜻蜓FM去广告
#!desc=移除开屏广告、信息流广告、各类相关内容推荐，精简我的页面。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/QtingFM.png
#!category=去广告

[Rule]
DOMAIN, ad.qtfm.cn, REJECT
DOMAIN, adlaunch.qtfm.cn, REJECT

[Body Rewrite]
http-response-jq (?i)^https:\/\/app\.qtfm\.cn\/m-bff\/v\d\/signin\/show_homepage_icon$ '.data.display_icon = false'
http-response-jq (?i)^https:\/\/app\.qtfm\.cn\/recommendapi\/v\d\/hotpage\? '.data.head |= map(select(.type == "IconGrid")) | .data.feeds |= map(select(.type == "Channel" or .type == "Radio" or .type == "ListenListChannel"))'
http-response-jq (?i)^https:\/\/app\.qtfm\.cn\/m-bff\/v\d\/channel\/\d{6}\/playpage\/\d{8} 'del(.data.related_recommend) | del(.data.recommend_bar)'
http-response-jq (?i)^https:\/\/app\.qtfm\.cn\/m-bff\/v\d\/mylistenpage 'del(.data.banner)'
http-response-jq (?i)^https:\/\/app\.qtfm\.cn\/m-bff\/v\d\/subscribed_channels\? 'del(.data.recommends)'
http-response-jq (?i)^https:\/\/app\.qtfm\.cn\/m-bff\/v1\/channelpage\/\d+$ 'del(.data.vip_recommend) | del(.data.recommend_delivery)'

[Map Local]
(?i)^https:\/\/app\.qtfm\.cn\/recommendapi\/v8\/ai_assistant_point$ data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/app\.qtfm\.cn\/m-bff\/v1\/signin\/show_homepage_icon$ data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/app\.qtfm\.cn\/recommendapi\/v\d\/emotion$ data-type=text data="" status-code=404
(?i)^https:\/\/search\.qtfm\.cn\/v\d\/keyword\/default$ data-type=text data="" status-code=404
(?i)^https:\/\/app\.qtfm\.cn\/m-bff\/v1\/user\/task\/play$ data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/app\.qtfm\.cn\/m-bff\/v\d\/i_listen\/guess_you_like\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/recpage-c\.qtfm\.cn\/v\d\/favorites$ data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/user\.qtfm\.cn\/u\d\/api\/v\d\/user\/following_podcaster\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/entry\.qtfm\.cn\/api\/v\d\/personal\/\?carrier data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/search\.qtfm\.cn\/v3\/entry$ data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/woqt2\.qtfm\.cn\/v2\/userConfig\? data-type=text data="{}" header="Content-Type:application/json" status-code=200

[MITM]
hostname = %APPEND% app.qtfm.cn, entry.qtfm.cn, recpage-c.qtfm.cn, user.qtfm.cn, search.qtfm.cn, woqt2.qtfm.cn
