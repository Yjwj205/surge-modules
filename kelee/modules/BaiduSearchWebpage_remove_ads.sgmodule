#!name=百度网页去广告
#!desc=移除百度搜索移动端网页的首页广告信息流
#!author=Keywos[https://github.com/Keywos]
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Baidu.png
#!category=去广告

[Script]
BaiduSearchWebpage_remove_ads · 移除百度搜索首页信息流广告 = type=http-response, pattern=(?i)^https?:\/\/(www|m)\.baidu\.com\/?($|\?from=\w{8,9}), script-path=https://raw.githubusercontent.com/Yjwj205/surge-modules/main/kelee/scripts/JavaScript/BaiduSearch/BaiduSearchHomePage_remove_ads.js, requires-body=1, max-size=-1

[MITM]
hostname = %APPEND% m.baidu.com, www.baidu.com
