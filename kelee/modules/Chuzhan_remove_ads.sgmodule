#!name=触站去广告
#!desc=移除开屏广告、弹窗广告、各页面横幅推广，移除首页悬浮挂件。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Chuzhan.png
#!category=去广告

[Body Rewrite]
http-response-jq (?i)^https:\/\/app\.huashi6\.com\/app\/common\/config$ '.data.disableAd = true | .data.showTopFloatAdvanceTips = false'
http-response-jq (?i)^https:\/\/app\.huashi6\.com\/app\/common\/config$ 'del(.data.adsConfigIOS) | del(.data.adsConfigAndroid) | del(.data.url.tabMarket)'
http-response-jq (?i)^https:\/\/app\.huashi6\.com\/app\/common\/layouts$ '.data |= {CZ_MINE_MENUS: .CZ_MINE_MENUS}'
http-response-jq (?i)^https:\/\/app\.huashi6\.com\/app\/common\/themeConfig$ '.data.tabbars |= map(select(.title != "商城"))'

[Map Local]
(?i)^https:\/\/app\.huashi6\.com\/app\/index\/ad\/ data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/app\.huashi6\.com\/app\/works\/relative$ data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/app\.huashi6\.com\/app\/index\/follow\/all_random\/list$ data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/app\.huashi6\.com\/app\/index\/csyxh\/icon$ data-type=text data="{}" header="Content-Type:application/json" status-code=200

[MITM]
hostname = %APPEND% app.huashi6.com
