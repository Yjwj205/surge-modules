#!name=Keep去广告
#!desc=移除开屏广告、搜索推荐和弹窗广告，精简底栏和首页标签。移除关注推荐、文章相关推荐和信息流中的课程推广。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Keep.png
#!category=去广告

[Rule]
DOMAIN, kad.gotokeep.com, REJECT

[Body Rewrite]
http-response-jq (?i)^https:\/\/api\.gotokeep\.com\/op-engine-webapp\/v1\/configs$ 'del(.data.adTimeoutReport) | del(.data.spotShowReport) | del(.data.adSupplementIntervalMinutes) | del(.data.adSupplementSwitch) | del(.data.hotFeedSpotAdRequestMoment) | del(.data.activityBrandFeedSpotAdRequestMoment) | del(.data.searchFeedSpotAdRequestMoment) | del(.data.feedDetailSpotAdRequestMoment) | del(.data.homePageFeedSpotAdRequestMoment) | del(.data.followFeedSpotAdRequestMoment) | del(.data.hotFeedRecommendSpotAdRequestMoment) | del(.data.activityFeedSpotAdRequestMoment) | del(.data.hotFeedFindSpotAdRequestMoment) | del(.data.hotFeedSpotFixedPositionSecond) | del(.data.searchFeedSpotFixedPositionSecond) | del(.data.followFeedSpotFixedPositionSecond) | del(.data.activityFeedSpotFixedPositionSecond) | del(.data.searchFeedSpotFixedPositionThird) | del(.data.hotFeedFindSpotFixedPositionSecond) | del(.data.hotFeedFindSpotFixedPositionThird) | del(.data.activityFeedSpotFixedPositionInitial) | del(.data.activityFeedSpotFixedPositionThird) | del(.data.hotFeedDynamicSpotPosition) | del(.data.feedDetailDynamicSpotPosition) | del(.data.hotFeedRecommendDynamicSpotPosition) | del(.data.hotFeedFindDynamicSpotPosition) | del(.data.homePageFeedDynamicSpotPosition) | del(.data.followFeedDynamicSpotPosition) | del(.data.searchFeedSpotPositionDynamic) | del(.data.activityFeedSpotPositionDynamic) | del(.data.activityBrandFeedSpotPositionDynamic) | del(.data.splashAdLoadTimeLimit) | del(.data.courseAdLoadTimeLimit) | del(.data.feedAdLoadTimeLimit) | del(.data.aliHCSpotConfig) | del(.data.gdtSpotConfig) | del(.data.pugcThresholdPercent) | del(.data.pugcStepMinSeconds) | del(.data.pugcStepMaxSeconds) | del(.data.pugcPreLoadEarlySeconds) | del(.data.pugcLoadPostPreRolls) | del(.data.closeConfirmButtonText)'
http-response-jq (?i)^https:\/\/api\.gotokeep\.com\/twins\/union\/feed\/union_feed_all$ '.data.modules |= map(select(.code == "unionFeedEntry"))'
http-response-jq (?i)^https:\/\/api\.gotokeep\.com\/twins\/v4\/feed\/entryDetail\? '.data = {}'
http-response-jq (?i)^https:\/\/api\.gotokeep\.com\/config\/v3\/basic\? '.data.bottomBarControl.tabs |= map(select(.tabType | . == "home" or . == "schedule" or . == "dynamic_sports" or . == "personal")) | .data.homeTabs |= map(select(.type | . == "socialTab" or . == "union_feed_all" or . == "homeRecommend" or . == "suitTab" or . == "union_feed_route"))'
http-response-jq (?i)^https:\/\/api\.gotokeep\.com\/pencil-webapp\/play\/v1\/games\? '.data.games[].microGames[] |= if .leftIcon? and .leftIcon.type == "aiMode" then del(.leftIcon) else . end'

[Map Local]
(?i)^https:\/\/api\.gotokeep\.com\/op-engine-webapp\/v1\/ad\/ data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/api\.gotokeep\.com\/search\/v6\/default\/keyword\/list\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/api\.gotokeep\.com\/twins\/v4\/feed\/followPage\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/api\.gotokeep\.com\/twins\/union\/feed\/function\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/api\.gotokeep\.com\/guide-webapp\/v1\/popup\/getPopUp\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/api\.gotokeep\.com\/search\/v5\/hotCourse\/list$ data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/api\.gotokeep\.com\/search\/v4\/hotHashtag\/list$ data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/api\.gotokeep\.com\/search\/v4\/hotword\/list\? data-type=text data="{}" header="Content-Type:application/json" status-code=200

[MITM]
hostname = %APPEND% api.gotokeep.com
