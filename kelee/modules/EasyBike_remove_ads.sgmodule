EasyBike_remove_ads · 去广告 = type=http-response, pattern=(?i)^https:\/\/mobileconfig-gateway\.hellobike\.com\/api$, script-path=https://kelee.one/Resource/JavaScript/EasyBike/mobileconfig-gateway.js, requires-body=1, max-size=-1

[MITM]
hostname = %APPEND% mobileconfig-gateway.hellobike.com
