#!name=飞客去广告
#!desc=移除开屏广告、首页广告、板块广告、帖内广告和我的页面广告。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/FlyerTea.png
#!category=去广告

[Map Local]
(?i)^https:\/\/www\.flyert\.com\.cn\/api\/mobile\/index\.php\?module=advis data-type=text data="" status-code=404
(?i)^https:\/\/www\.flyert\.com\.cn\/api\/mobile\/index\.php\?module=vip_coupon data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/ptf\.flyertrip\.com\/static\/img\/common\/ic_plate_mine_button\.png data-type=tiny-gif status-code=200
(?i)^https:\/\/www\.flyert\.com\.cn\/api\/mobile\/index\.php\?module=getdata data-type=text data="{}" header="Content-Type:application/json" status-code=200

[Script]
FlyerTea_remove_ads · 移除板块广告 = type=http-response, pattern=(?i)^https:\/\/www\.flyert\.com\.cn\/api\/mobile\/index\.php\?version=5, script-path=https://raw.githubusercontent.com/Yjwj205/surge-modules/main/kelee/scripts/JavaScript/FlyerTea/FlyerTea_remove_ads.js, requires-body=1, max-size=-1
FlyerTea_remove_ads · 移除签到弹窗广告 = type=http-response, pattern=(?i)^https:\/\/www\.flyert\.com\.cn\/api\/mobile\/index\.php\?module=plugin&id=k_misign:sign, script-path=https://raw.githubusercontent.com/Yjwj205/surge-modules/main/kelee/scripts/JavaScript/FlyerTea/FlyerTea_remove_ads.js, requires-body=1, max-size=-1

[MITM]
hostname = %APPEND% www.flyert.com.cn, ptf.flyertrip.com
