[Map Local]
(?i)^https:\/\/pan-api\.bitqiu\.com\/activity\/getPromoteGuide$ data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^http:\/\/pan-api\.bitqiu\.com\/activity\/getUrlList$ data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/pan-api\.bitqiu\.com\/activity\/guides$ data-type=text data="{}" header="Content-Type:application/json" status-code=200

[MITM]
hostname = %APPEND% pan-api.bitqiu.com
