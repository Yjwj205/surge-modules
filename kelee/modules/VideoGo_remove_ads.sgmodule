[Map Local]
(?i)^https:\/\/api\.ys7\.com\/api\/ads data-type=text data="" status-code=404
(?i)^https:\/\/i\.ys7\.com\/api\/user\/tabList data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/api\.ys7\.com\/v3\/config\/service\/entrance\/bannerInfo data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/api\.ys7\.com\/v3\/intelligent-app\/apps\/linkage data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/api\.ys7\.com\/v3\/configurations\/gray\/info\?grayTypes=185 data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/api\.ys7\.com\/v3\/videoclips\/square\/video\/query data-type=text data="{}" header="Content-Type:application/json" status-code=200

[MITM]
hostname = %APPEND% api.ys7.com, i.ys7.com
