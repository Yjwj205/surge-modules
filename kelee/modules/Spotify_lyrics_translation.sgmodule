#!name=Spotify歌词增强
#!desc=将Spotify的外语歌词翻译为简体中文，并提供双语翻译支持。
#!author=VirgilClyne[https://github.com/VirgilClyne]
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Spotify.png
#!category=功能增强

[Script]
Spotify_lyrics_translation · 跟踪响应·JSON = type=http-response, pattern=(?i)^https?:\/\/api\.spotify\.com\/v1\/tracks\?, script-path=https://raw.githubusercontent.com/Yjwj205/surge-modules/main/kelee/scripts/JavaScript/Spotify/Spotify_response.js, requires-body=1, max-size=-1
Spotify_lyrics_translation · 歌词请求·JSON = type=http-request, pattern=(?i)^https?:\/\/spclient\.wg\.spotify\.com\/color-lyrics\/v2\/track\/(.+)\?(.*)format=json, script-path=https://raw.githubusercontent.com/Yjwj205/surge-modules/main/kelee/scripts/JavaScript/Spotify/Spotify_request.js, requires-body=1, max-size=-1
Spotify_lyrics_translation · 歌词请求·Proto = type=http-request, pattern=(?i)^https?:\/\/spclient\.wg\.spotify\.com\/color-lyrics\/v2\/track\/\w+\?(.*), script-path=https://raw.githubusercontent.com/Yjwj205/surge-modules/main/kelee/scripts/JavaScript/Spotify/Spotify_request.js, requires-body=1, binary-body-mode=1, max-size=-1
Spotify_lyrics_translation · 翻译歌词响应·JSON = type=http-response, pattern=(?i)^https?:\/\/spclient\.wg\.spotify\.com\/color-lyrics\/v2\/track\/(.+)\?(.*)format=json(.*)subtype=Translate, script-path=https://raw.githubusercontent.com/Yjwj205/surge-modules/main/kelee/scripts/JavaScript/Spotify/Translate_response.js, requires-body=1, max-size=-1
Spotify_lyrics_translation · 翻译歌词响应·Proto = type=http-response, pattern=(?i)^https?:\/\/spclient\.wg\.spotify\.com\/color-lyrics\/v2\/track\/\w+\?(.*)subtype=Translate, script-path=https://raw.githubusercontent.com/Yjwj205/surge-modules/main/kelee/scripts/JavaScript/Spotify/Translate_response.js, requires-body=1, binary-body-mode=1, max-size=-1
Spotify_lyrics_translation · 外部歌词响应·JSON = type=http-response, pattern=(?i)^https?:\/\/spclient\.wg\.spotify\.com\/color-lyrics\/v2\/track\/(.+)\?(.*)format=json(.*)subtype=External, script-path=https://raw.githubusercontent.com/Yjwj205/surge-modules/main/kelee/scripts/JavaScript/Spotify/External_Lyrics_response.js, requires-body=1, max-size=-1
Spotify_lyrics_translation · 外部歌词响应·Proto = type=http-response, pattern=(?i)^https?:\/\/spclient\.wg\.spotify\.com\/color-lyrics\/v2\/track\/\w+\?(.*)subtype=External, script-path=https://raw.githubusercontent.com/Yjwj205/surge-modules/main/kelee/scripts/JavaScript/Spotify/External_Lyrics_response.js, requires-body=1, binary-body-mode=1, max-size=-1

[MITM]
hostname = %APPEND% api.spotify.com, spclient.wg.spotify.com
