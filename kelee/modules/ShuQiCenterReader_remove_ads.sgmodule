#!name=书旗小说去广告
#!desc=移除书城横幅广告、听书广告、阅读广告、章末推荐、福利入口、悬浮窗、推荐搜索词，精简我的页面。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/ShuQiCenterReader.png
#!category=去广告

[Rule]
DOMAIN, render-web.11222.cn, REJECT

[Map Local]
(?i)^https:\/\/huichuan\.sm\.cn\/nativead data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/ocean\.shuqireader\.com\/api\/route\/iosReadPage\/adV2 data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/ocean\.shuqireader\.com\/api\/route\/ios\/readPage$ data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/ocean\.shuqireader\.com\/api\/render\/load\/resource data-type=text data="" status-code=404

[Script]
ShuQiCenterReader_remove_ads · 移除书城横幅和阅读广告 = type=http-response, pattern=(?i)^https:\/\/ocean\.shuqireader\.com\/sqios\/render\/render\/page\/bookstore$, script-path=https://raw.githubusercontent.com/Yjwj205/surge-modules/main/kelee/scripts/JavaScript/ShuQiCenterReader/ShuQiCenterReader_remove_ads.js, requires-body=1, max-size=-1

[MITM]
hostname = %APPEND% ocean.shuqireader.com, huichuan.sm.cn
