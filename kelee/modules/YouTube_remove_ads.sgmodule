#!name=YouTube去广告
#!desc=移除YouTube视频、瀑布流、搜索和Shorts中的广告，移除底栏的Shorts按钮和上传按钮，增加画中画及字幕翻译功能。移除YouTube Music底栏的上传、选段和升级按钮，增加歌词翻译，支持二者的后台播放。此插件需要启用MitM over HTTP/2和QUIC回退保护。支持Premium订阅用户使用，不支持tvOS设备。
#!author=Maasea[https://github.com/Maasea], VirgilClyne[https://github.com/VirgilClyne], Choler[https://github.com/Choler], DivineEngine[https://github.com/DivineEngine], app2smile[https://github.com/app2smile]
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/YouTube.png
#!category=去广告
#!arguments=blockUpload:false,blockShorts:false,blockImmersive:false,captionLang:zh-Hans,debug:false
#!arguments-desc=[blockUpload] 隐藏上传按钮 / [blockShorts] 隐藏Shorts按钮 / [blockImmersive] 隐藏选段按钮 / [captionLang] 字幕翻译语言 / [debug] 启用调试模式

[Script]
YouTube_remove_ads · YouTube去广告 = type=http-response, pattern=(?i)^https:\/\/youtubei\.googleapis\.com\/(youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch|log_event|config))(\?(.*))?$, script-path=https://raw.githubusercontent.com/Yjwj205/surge-modules/main/kelee/scripts/JavaScript/YouTube/YouTube_remove_ads/YouTube_remove_ads_response.js, argument="blockUpload={{{blockUpload}}}&blockShorts={{{blockShorts}}}&blockImmersive={{{blockImmersive}}}&captionLang={{{captionLang}}}&debug={{{debug}}}", requires-body=1, binary-body-mode=1, max-size=-1
YouTube_remove_ads · 请求初始化 = type=http-request, pattern=(?i)^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback.+&ack.*, script-path=https://raw.githubusercontent.com/Yjwj205/surge-modules/main/kelee/scripts/JavaScript/YouTube/YouTube_remove_ads/YouTube_remove_ads_request.js, argument="captionLang={{{captionLang}}}", requires-body=1, binary-body-mode=1, max-size=-1
YouTube_remove_ads · 请求日志事件 = type=http-request, pattern=(?i)^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/log_event, script-path=https://raw.githubusercontent.com/Yjwj205/surge-modules/main/kelee/scripts/JavaScript/YouTube/YouTube_remove_ads/YouTube_remove_ads_request.js, argument="blockUpload={{{blockUpload}}}&blockShorts={{{blockShorts}}}&blockImmersive={{{blockImmersive}}}&captionLang={{{captionLang}}}&debug={{{debug}}}", requires-body=1, binary-body-mode=1, max-size=-1

[MITM]
hostname = %APPEND% *.googlevideo.com, youtubei.googleapis.com
