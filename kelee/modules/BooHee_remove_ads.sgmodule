#!name=薄荷健康去广告
#!desc=移除记录页大家都在看、移除各类弹窗，移除广场横幅推广，精简代谢中心页面。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/BooHee.png
#!category=去广告

[Body Rewrite]
http-response-jq (?i)^https:\/\/api\.boohee\.com\/meta-interface\/v2\/index\? 'del(.data.recom_cards) | del(.data.recom_btns)'
http-response-jq (?i)^https:\/\/api\.boohee\.com\/meta-interface\/v1\/index\/plaza\? 'del(.data."tabs[1]".badge) | del(.data.recommend_ads)'
http-response-jq (?i)^https:\/\/api\.boohee\.com\/open-interface\/v1\/string\/market_page\?title=metabolism_config$ 'del(.top_banner) | del(.diagnos_config) | del(.partner_hospital) | del(.question_answer) | del(.product) | del(.brand_story)'

[Map Local]
(?i)^https:\/\/api\.boohee\.com\/meta-interface\/v1\/index\/page_float_bubbles\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/api\.boohee\.com\/meta-interface\/v1\/index\/tool_buttons\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/api\.boohee\.com\/app-interface\/v1\/search\/search\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/status\.boohee\.com\/api\/v1\/merged_messages$ data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/bohe\.sfo-tx-shanghai-01\.saas\.sensorsdata\.cn\/api\/v2\/sfo\/user_popup_configs\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/api\.boohee\.com\/meta-interface\/v1\/index\/sensor-banners\? data-type=text data="{}" header="Content-Type:application/json" status-code=200

[Script]
BooHee_remove_ads · 移除广场推荐页面横幅 = type=http-response, pattern=(?i)^https:\/\/api\.boohee\.com\/meta-interface\/v1\/index\/plaza-flow\?, script-path=https://raw.githubusercontent.com/Yjwj205/surge-modules/main/kelee/scripts/JavaScript/BooHee/BooHee_remove_ads.js, requires-body=1, max-size=-1

[MITM]
hostname = %APPEND% api.boohee.com, bohe.sfo-tx-shanghai-01.saas.sensorsdata.cn, lego.boohee.com, status.boohee.com
