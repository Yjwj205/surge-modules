#!name=慧生活798去广告
#!desc=移除开屏广告、横幅广告，精简底栏。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/SmartLife.png
#!category=去广告

[Body Rewrite]
http-response-jq (?i)^https:\/\/i\.ilife798\.com\/api\/v\d\/acc\/login$ 'del(.data.ar) | del(.data.showAd)'

[Map Local]
(?i)^https:\/\/i\.ilife798\.com\/api\/v\d\/acc\/score\/mission-lst$ data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/i\.ilife798\.com\/api\/v\d\/ep\/lst-simple\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/i\.ilife798\.com\/api\/v\d\/ui\/app\/master$ data-type=text data="{}" header="Content-Type:application/json" status-code=200

[MITM]
hostname = %APPEND% i.ilife798.com
