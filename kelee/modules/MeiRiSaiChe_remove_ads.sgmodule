#!name=每日赛车去广告
#!desc=移除开屏广告、信息流广告。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/MeiRiSaiChe.png
#!category=去广告

[Body Rewrite]
http-response-jq (?i)^https:\/\/api\.romielf\.com\/index\/indexv\d\? '.data.advertisement = [] | .data.listadvertising = []'
http-response-jq (?i)^https:\/\/api\.romielf\.com\/index\/indexv\d\? '.data.list |= map(select(.type == 1))'

[MITM]
hostname = %APPEND% api.romielf.com
