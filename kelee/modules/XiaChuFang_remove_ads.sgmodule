#!name=下厨房去广告
#!desc=移除开屏广告、页面推广及横幅，精简首页标签。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/XiaChuFang.png
#!category=去广告

[Body Rewrite]
http-response-jq (?i)^https:\/\/api\.xiachufang\.com\/v2\/homepage\/paged_waterfall_recommendations\.json$ 'del(.multiplex_cells[] | select(.recommendation_cell.impression_sensor_events[]?.properties.target_type? == "ad"))'
http-response-jq (?i)^https:\/\/api\.xiachufang\.com\/v2\/config\/get\.json$ 'del(.content.recipe_ad) | del(.content.splash_ad_req_time) | del(.content.splash_sdk_ad_req_time) | del(.content.splash_ad_lifecycle_interval) | del(.content.waterfall_ad_feedback) | del(.content.homepage_waterfall_test_ad_pos) | del(.content.ad_app_look_around) | del(.content.ad_sdk_text_removal_keywords)'
http-response-jq (?i)^https:\/\/api\.xiachufang\.com\/v2\/homepage\/ranking_list\/paged_homepage_ranking_list_section_v2\.json$ '.cells |= map(del(.side_slip_activity_cell, .dish_square_cell))'

[Map Local]
(?i)^https:\/\/api\.xiachufang\.com\/v2\/ad\/ data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/api\.xiachufang\.com\/v2\/account\/feeds_v7\.json data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/api\.xiachufang\.com\/v2\/homepage1810\/init_page\.json data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/api\.xiachufang\.com\/v2\/mark_mission\/get_sticker_info\.json data-type=text data="{}" header="Content-Type:application/json" status-code=200

[MITM]
hostname = %APPEND% api.xiachufang.com
