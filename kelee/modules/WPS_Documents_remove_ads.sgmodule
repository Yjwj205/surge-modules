[Map Local]
(?i)^https:\/\/www\.kdocs\.cn\/kdg\/api\/v1\/cards\/type\/3\?iosVer=\d+\.\d+\.\d+&isGetList=1 data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/www\.kdocs\.cn\/kdg\/api\/v1\/cards\/type\/27\?iosVer=\d+\.\d+\.\d+&isGetList=1 data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/f-api\.kdocs\.cn\/godfather\/api\/thirdparty\/v1\/viewpager\?showLocal=mobileWebIndex data-type=text data="{}" header="Content-Type:application/json" status-code=200

[MITM]
hostname = %APPEND% www.kdocs.cn, f-api.kdocs.cn
