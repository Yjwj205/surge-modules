#!name=百度输入法去广告
#!desc=过滤百度输入法广告，替换个人主页随机图。
#!author=Keywos[https://github.com/Keywos]
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Baidu_input_method.png
#!category=去广告

[Map Local]
(?i)^https?:\/\/mime\.baidu\.com\/v5\/start_screen_ads\/list data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https?:\/\/mime\.baidu\.com\/sapi\/v1\/lccorpus\/(applist|pannellist) data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https?:\/\/mime\.baidu\.com\/sapi\/v1\/(circle\/joinedlist|lccorpus\/usercorpussync|aihelpactivity\/aihelpresource) data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https?:\/\/mime\.baidu\.com\/commer\/pocket_api\/enterprise_list data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https?:\/\/mbd\.baidu\.com\/ccs\/v1\/start\/confsync\?appname=baidu_input data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/mime\.baidu\.com\/v5\/(fb\/st\?logtype|(notiv3|cellloc_noti|noti_cloudswitch_noti)\/info) data-type=text data="{}" header="Content-Type:application/json" status-code=200

[Script]
Baidu_input_method_remove_ads · 百度输入法去广告 = type=http-response, pattern=(?i)^https?:\/\/mime\.baidu\.com\/(imrobot\/v1\/pub\/relation\/get_robot_list|v5\/custom_page\/(layout|getdata)), script-path=https://raw.githubusercontent.com/Yjwj205/surge-modules/main/kelee/scripts/JavaScript/Baidu_input_method/Baidu_input_method_remove_ads.js, requires-body=1, max-size=-1

[MITM]
hostname = %APPEND% imeres.baidu.com, mbd.baidu.com, mime.baidu.com
