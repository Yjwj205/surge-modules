#!name=IT之家去广告
#!desc=过滤IT之家信息流广告和文末广告，自定义移除置顶和轮播图，自定义移除项需在插件配置。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/IThome.png
#!category=去广告
#!arguments=removePinnedArticles:false,removeAllBanners:false
#!arguments-desc=[removePinnedArticles] 移除置顶文章 / [removeAllBanners] 移除全部横幅

[Map Local]
(?i)^https?:\/\/dat\.ruanmei\.com\/ithome\/money\/acd\.json$ data-type=text data="" status-code=404

[Script]
IThome_remove_ads · IT之家去广告 = type=http-response, pattern=(?i)^https:\/\/napi\.ithome\.com\/api\/(news\/indexv2\/iphone\/\d+|topmenu\/getfeeds\?), script-path=https://raw.githubusercontent.com/Yjwj205/surge-modules/main/kelee/scripts/JavaScript/IThome/IThome_remove_ads.js, argument="removeAllBanners={{{removeAllBanners}}}&removePinnedArticles={{{removePinnedArticles}}}", requires-body=1, max-size=-1

[MITM]
hostname = %APPEND% napi.ithome.com, api.zuihuimai.com, dat.ruanmei.com
