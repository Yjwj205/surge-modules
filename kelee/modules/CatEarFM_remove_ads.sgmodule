#!name=猫耳FM去广告
#!desc=移除开屏广告、青少年模式弹窗、首页顶部入口，替换底栏的直播入口为发现入口。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/CatEarFM.png
#!category=去广告

[Body Rewrite]
http-response-jq (?i)^https:\/\/app\.missevan\.com\/site\/launch\? 'del(.info.splash) | del(.info.splash_ready)'
http-response-jq (?i)^https:\/\/app\.missevan\.com\/site\/config$ 'del(.info.tab_bar_live) | del(."0") | del(.info.enable_tab_bar_live_notice) | del(.false) | del(.info.teenager_popup_mode) | del(."0")'
http-response-jq (?i)^https:\/\/app\.missevan\.com\/site\/config$ 'del(.info.httpdns) | del(.info.homepage_top_task_button)'
http-response-jq (?i)^https:\/\/app\.missevan\.com\/site\/config$ '.info.cronet |= (fromjson | .quic=false | tojson)'
http-response-jq (?i)^https:\/\/app\.missevan\.com\/site\/tabs\? '.info.tabs |= map(select(.title as $t | ["直播", "发现", "广播剧", "听书", "分类"] | index($t) != null))'
http-response-jq (?i)^https:\/\/app\.missevan\.com\/site\/icons\? '.info.icons |= map(select(.title as $t | $t == "直播" or $t == "必听剧" or $t == "免费榜" or $t == "夜猫子" or $t == "启动音"))'
http-response-jq (?i)^https:\/\/app\.missevan\.com\/discovery\/list$ '.info |= map(map(select(.title != "免流服务")))'
http-response-jq (?i)^https:\/\/app\.missevan\.com\/site\/get-top$ 'del(.info.search_words)'

[Map Local]
(?i)^https:\/\/data\.missevan\.com\/site\/ad-track$ data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/app\.missevan\.com\/x\/recommend\/get-popup$ data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/fm\.missevan\.com\/api\/v2\/meta\/banner$ data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/fm\.missevan\.com\/api\/v2\/recommended\/top\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/fm\.missevan\.com\/api\/v2\/chatroom\/sound\/recommend\? data-type=text data="{}" header="Content-Type:application/json" status-code=200

[MITM]
hostname = %APPEND% app.missevan.com, data.missevan.com, fm.missevan.com
