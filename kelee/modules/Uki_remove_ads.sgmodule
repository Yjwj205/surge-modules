#!name=Uki去广告
#!desc=移除开屏广告、应用内悬浮窗，各类横幅、信息流广告、搜索填充词、我的页面广告。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Uki.png
#!category=去广告

[Map Local]
(?i)^https:\/\/api\.chenlongtech\.cn\/v\d\/friends\/startInfo$ data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/api\.chenlongtech\.cn\/v\d\/friends\/indexBanner$ data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/api\.chenlongtech\.cn\/v\d\/friends\/getPopup data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/api\.chenlongtech\.cn\/v\d\/friends\/allPopUpConfig$ data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/api\.chenlongtech\.cn\/v\d\/friends\/advConf$ data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/api\.chenlongtech\.cn\/v\d\/user\/checkQTSheInsurance$ data-type=text data="{}" header="Content-Type:application/json" status-code=200

[Script]
Uki_remove_ads · 移除匹配卡横幅 = type=http-response, pattern=(?i)^https:\/\/api\.chenlongtech\.cn\/v\d\/lover\/productList, script-path=https://raw.githubusercontent.com/Yjwj205/surge-modules/main/kelee/scripts/JavaScript/Uki/Uki_remove_ads.js, requires-body=1, max-size=-1
Uki_remove_ads · 移除密友横幅 = type=http-response, pattern=(?i)^https:\/\/api\.chenlongtech\.cn\/v\d\/friends\/closeFriend\/home, script-path=https://raw.githubusercontent.com/Yjwj205/surge-modules/main/kelee/scripts/JavaScript/Uki/Uki_remove_ads.js, requires-body=1, max-size=-1
Uki_remove_ads · 移除娱乐页面横幅和悬浮窗配置 = type=http-response, pattern=(?i)^https:\/\/api\.chenlongtech\.cn\/v\d\/party\/config$, script-path=https://raw.githubusercontent.com/Yjwj205/surge-modules/main/kelee/scripts/JavaScript/Uki/Uki_remove_ads.js, requires-body=1, max-size=-1
Uki_remove_ads · 移除广场搜索填充词 = type=http-response, pattern=(?i)^https:\/\/api\.chenlongtech\.cn\/v1\/post\/fetchSearchRecommend$, script-path=https://raw.githubusercontent.com/Yjwj205/surge-modules/main/kelee/scripts/JavaScript/Uki/Uki_remove_ads.js, requires-body=1, max-size=-1

[MITM]
hostname = %APPEND% api.chenlongtech.cn
