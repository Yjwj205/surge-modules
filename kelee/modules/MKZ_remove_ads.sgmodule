#!name=漫客栈去广告
#!desc=移除开屏广告、漫画广告、小说章末广告，精简我的页面。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/MKZ.png
#!category=去广告

[Map Local]
(?i)^https:\/\/base\.mkzcdn\.com\/advert\/app\/read\/v\d data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/base\.mkzcdn\.com\/advert\/app\/story\/read\/v\d data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/base\.mkzcdn\.com\/advert\/app\/task\/motivate\/v\d data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/base\.mkzcdn\.com\/advert\/app\/task\/motivate\/v\d data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/base\.mkzcdn\.com\/advert\/app\/user\/slide\d\/v\d\/ data-type=text data="{}" header="Content-Type:application/json" status-code=200

[Script]
MKZ_remove_ads · 配置修改 = type=http-response, pattern=(?i)^https:\/\/base\.mkzcdn\.com\/app\/config\/, script-path=https://raw.githubusercontent.com/Yjwj205/surge-modules/main/kelee/scripts/JavaScript/MKZ/MKZ_remove_ads.js, requires-body=1, max-size=-1

[MITM]
hostname = %APPEND% base.mkzcdn.com
