#!name=排班日历去广告
#!desc=移除开屏广告、横幅广告。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/AxWorkSchedule.png
#!category=去广告

[Map Local]
(?i)^https:\/\/schedule-api\.julanling\.com\/api\d\/get_splash$ data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/schedule-api\.julanling\.com\/api\d\/index_advert$ data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/schedule-api\.julanling\.com\/api\d\/queryAdvertConfig$ data-type=text data="{}" header="Content-Type:application/json" status-code=200

[MITM]
hostname = %APPEND% schedule-api.julanling.com
