#!category=去广告

[Map Local]
(?i)^https:\/\/mall\.meituan\.com\/api\/c\/homepage\/splash data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/mall\.meituan\.com\/api\/c\/homepage\/bubble\/operate\/info data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/mall\.meituan\.com\/api\/c\/jigsaw\/code\/category-banner-\d+\/ data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/mall\.meituan\.com\/api\/c\/poi\/\d+\/order\/recommend\/v\d data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/mall\.meituan\.com\/api\/c\/banner\/ data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/mall\.meituan\.com\/api\/c\/poi\/\d+\/personal\/recommend data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/businessapi\.ksedt\.com\/signupindex\/jxlist data-type=text data="{}" header="Content-Type:application/json" status-code=200

[Script]
iMaiCai_remove_ads · 移除下发广告 = type=http-response, pattern=(?i)^https:\/\/portal-portm\.meituan\.com\/horn_ios\/mergeRequest, script-path=https://raw.githubusercontent.com/Yjwj205/surge-modules/main/kelee/scripts/JavaScript/iMaiCai/iMaiCai_remove_ads.js, requires-body=1, max-size=-1

[MITM]
hostname = %APPEND% portal-portm.meituan.com, mall.meituan.com, businessapi.ksedt.com
