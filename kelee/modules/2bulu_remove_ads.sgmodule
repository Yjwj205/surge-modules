#!name=两步路户外助手去广告
#!desc=移除开屏广告、弹窗广告，精简我的页面。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/2bulu.png
#!category=去广告

[Body Rewrite]
http-response-jq (?i)^https:\/\/helper\.2bulu\.com\/getAppEntranceConfig\? '.configData=(.configData|fromjson|del(.adPlatform,.adIntertitialShowType,.adsConfig,.adIntertitialDisplayedLimit,.adSplashShowTypeWhenHotStart,.adIntertitialDayDisplayedMaxCount,.od_adsType,.showMeBaiHeAdView)|tojson)'

[Map Local]
(?i)^https:\/\/helper\.2bulu\.com\/search\/searchHotKeyList\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/helper\.2bulu\.com\/promote\/getAppUserModule\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/helper\.2bulu\.com\/proSpecial\/allData\? data-type=text data="{}" header="Content-Type:application/json" status-code=200

[MITM]
hostname = %APPEND% helper.2bulu.com
