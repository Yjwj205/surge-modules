#!name=Sub-Store
#!desc=高级订阅管理工具，定时任务默认为每天23点55分，可在插件设置中自定义。使用前请在本插件的详情页面为[PROXY]项分配代理策略。
#!author=Peng-YM[https://github.com/Peng-YM]
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/Other_icon/120px/Sub-Store.png
#!category=订阅管理
#!arguments=cron:55 23 * * *,policy:PROXY
#!arguments-desc=[cron] 定时参数 / [policy] 策略

[Rule]
DOMAIN, sub-store.vercel.app,{{{policy}}}

[Script]
Sub-Store · Sub-Store Core = type=http-request, pattern=(?i)^https?:\/\/sub\.store\/((download)|api\/(preview|sync|(utils\/node-info))), script-path=https://github.com/sub-store-org/Sub-Store/releases/latest/download/sub-store-1.min.js, requires-body=1, max-size=-1, timeout=120
Sub-Store · Sub-Store Simple = type=http-request, pattern=(?i)^https?:\/\/sub\.store, script-path=https://github.com/sub-store-org/Sub-Store/releases/latest/download/sub-store-0.min.js, requires-body=1, max-size=-1, timeout=120
Sub-Store · Sub-Store Sync = type=cron, cronexp="{{cron}}", script-path=https://github.com/sub-store-org/Sub-Store/releases/latest/download/cron-sync-artifacts.min.js, timeout=120

[MITM]
hostname = %APPEND% sub.store
