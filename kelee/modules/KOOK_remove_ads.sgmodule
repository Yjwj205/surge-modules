#!name=KOOK去广告
#!desc=移除开屏广告、房间横幅推广、促销活动、精简发现页面频道及我的页面，移除底栏商城入口。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/KOOK.png
#!category=去广告

[Body Rewrite]
http-response-jq (?i)^https:\/\/(m|www)\.kookapp\.cn\/api\/v\d\/user\/settings$ 'del(.ad_banner) | del(.advertise_on_off)'
http-response-jq (?i)^https:\/\/(m|www)\.kookapp\.cn\/api\/v\d\/user\/settings$ '.ios_mall_switch = false'
http-response-jq (?i)^https:\/\/www\.kookapp\.cn\/api\/v3\/discover\/tab-list\? '.data.items |= map(select(.id == 472 or .id == 473 or .id == 475))'

[Map Local]
(?i)^https:\/\/www\.kookapp\.cn\/api\/v3\/ad\/config$ data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/www\.kookapp\.cn\/api\/v3\/promotion\/ongoing$ data-type=text data="{}" header="Content-Type:application/json" status-code=200

[MITM]
hostname = %APPEND% m.kookapp.cn, www.kookapp.cn
