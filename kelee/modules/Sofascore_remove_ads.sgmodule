[Map Local]
(?i)^https:\/\/api\.sofascore\.com\/api\/v\d\/dsp\/country\/[A-Z]{2}$ data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/api\.sofascore\.com\/api\/v\d\/trending\/grid\/tiles\/[A-Z]{2}$ data-type=base64 data="eyJ0aWxlcyI6W119" header="Content-Type:application/json" status-code=200

[MITM]
hostname = %APPEND% api.sofascore.com
